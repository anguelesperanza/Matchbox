package matchbox


/*
	colors
	======
	This is a file that has a list of colors in the form of [4]f32

	Constants, not variables: as variables a game could assign to WHITE and change
	what every later use of it means
*/

PUMPKIN_ORANGE  :: [4]f32{0.75, 0.30, 0.00, 1}
BLACK           :: [4]f32{0.00, 0.00, 0.00, 1}
WHITE           :: [4]f32{1.00, 1.00, 1.00, 1}
LIME_GREEN      :: [4]f32{0.39, 0.58, 0.29, 1}
CORNFLOWER_BLUE :: [4]f32{0.39, 0.58, 0.92, 1}
RED             :: [4]f32{1.00, 0.00, 0.00, 1}
DEEP_AMBER_RED  :: [4]f32{1.00, 0.20, 0.00, 1}
BROWN           :: [4]f32{0.50, 0.42, 0.31, 1}
GREEN           :: [4]f32{0.00, 0.89, 0.19, 1}
BLUE            :: [4]f32{0.00, 0.47, 0.95, 1}
MAROON          :: [4]f32{0.75, 0.13, 0.22, 1}
ORANGE          :: [4]f32{1.00, 0.63, 0.00, 1}
LIGHT_GRAY      :: [4]f32{0.78, 0.78, 0.78, 1}
PURPLE          :: [4]f32{0.78, 0.48, 1.00, 1}
SKY_BLUE        :: [4]f32{0.40, 0.75, 1.00, 1}
