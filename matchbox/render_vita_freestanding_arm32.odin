#+build freestanding arm32

package matchbox

/*
	Render -- Vita
	==============
	GXM draws the shared render queue (render.odin): camera_start sets the camera,
	render_mesh / render_sprite / the shapes record items, and camera_end sorts them with the
	shared sort and draws them here, the same scene in the same order as on PC and 3DS.

	There are three shaders, as on PC: mesh.mbs draws everything, and while lighting is on
	mesh_lit.mbs draws lit meshes per pixel (G2 L4-5) and mesh_vertex_lit.mbs per vertex (G2 L5),
	as each part's material says. Each is generated by mbsc (`-target:vita --emit-cg`) into
	<name>_v.cg and <name>_f.cg, and compiled by psp2cgc into <name>_v.gxp and <name>_f.gxp. All
	are committed, so a checkout builds without psp2cgc; the .gxp files are embedded with #load,
	as gfx does for its clear shaders.

	Inside `when VITA` for the reason in backend_vita_freestanding_arm32.odin
*/

import "core:mem"
import "core:strings"

import "vito/gfx"
import "vito/sce"

when VITA {

	/*
		The lights and the material as ONE program holds them. psp2cgc keeps a uniform only in the program that reads it, so
		the built-ins have these in the one program their lighting mode says, and a game shader may have each in its vertex
		program, its fragment program or both. A nil field is skipped by gfx.set_uniform, so writing a set to a program that
		does not hold it costs nothing
	*/
	Light_Parameters :: struct {
		ambient:^sce.GxmProgramParameter,
		direction:^sce.GxmProgramParameter,
		diffuse:^sce.GxmProgramParameter,
		specular:^sce.GxmProgramParameter,
		position:^sce.GxmProgramParameter,
		cone:^sce.GxmProgramParameter,
		split:^sce.GxmProgramParameter, // per pixel only: where the suns, the bulbs and all the lights end in the sorted block (nil per vertex, whose loop runs all 8)
		shininess:^sce.GxmProgramParameter,
		specular_strength:^sce.GxmProgramParameter,
	}

	/*
		One uniform of a game shader, in the vertex program and in the fragment program. The built-ins read each engine
		uniform in one known program, but a game shader reads any in either (a tint or the time is as likely to be used by
		the fragment stage), and psp2cgc drops it from the program that does not. nil where it is not
	*/
	Dual_Parameter :: struct {
		vertex:^sce.GxmProgramParameter,
		fragment:^sce.GxmProgramParameter,
	}

	// The engine's uniforms a game shader may read, besides the lights
	Engine_Uniform :: enum {
		VIEW_PROJECTION,
		VIEW,
		MODEL,
		TINT,
		UV_RECTANGLE,
		ALPHA_CUTOFF,
		TIME,
		SKIN_ROW0,
		SKIN_ROW1,
		SKIN_ROW2,
	}

	/*What a game shader's pipeline has that a built-in's does not: where each uniform lives, found once at load. nil in the built-ins*/
	Game_Bindings :: struct {
		engine:[Engine_Uniform]Dual_Parameter,
		vertex_lights:Light_Parameters,
		fragment_lights:Light_Parameters,
		/*
			Any lights_* uniform is read. Such a shader draws only while lighting is on (choose_game_shader): the lights are filled
			at camera_end only then, so with lighting off it would read zeros and draw black
		*/
		reads_lights:bool,
		uniforms:[]Dual_Parameter, // one per game uniform, in the order of Vita_Game_Uniforms.entries
		texture_units:[4]u32, // the fragment program's samplers that were kept, in the order the reflection lists them; the first takes the draw's texture
		texture_count:int,
	}

	/*
		Everything one shader needs to draw. Two live in Backend_State: `mbi.pipeline` and
		`mbi.lit_pipeline`. GXM ties a fragment program to its vertex program and its blend mode,
		so there is one fragment program per Blend_Mode, made up front and picked per draw
	*/
	Render_Pipeline :: struct {
		vertex_shader:gfx.Program,
		fragment_shader:gfx.Program,
		/*
			nil for the unlit shader. Otherwise it reads Lit_Vertex's normal, and the lights and the
			material: in the fragment program per pixel, in the vertex program per vertex
		*/
		lighting:Maybe(Lighting_Mode),
		skinned:bool, // reads a Skinned_Vertex and a joint palette
		vertex_program:^sce.GxmVertexProgram, // for the meshes the shader is meant for: Vertex, or Lit_Vertex when lit
		/*
			The unlit shader reading Lit_Vertex, for lit meshes while lighting is off: GXM fixes a
			stream's stride in the vertex program, and a Lit_Vertex starts with a whole Vertex.
			nil in the lit pipelines, which only ever read Lit_Vertex
		*/
		lit_vertex_program:^sce.GxmVertexProgram,
		fragment_programs:[Blend_Mode]^sce.GxmFragmentProgram,

		// Each engine uniform, found by name. mbsc names them <block>_<field>
		view_projection_uniform:^sce.GxmProgramParameter,
		model_uniform:^sce.GxmProgramParameter,
		tint_uniform:^sce.GxmProgramParameter,
		uv_rectangle_uniform:^sce.GxmProgramParameter,
		alpha_cutoff_uniform:^sce.GxmProgramParameter, // the fragment program's
		texture_unit:u32,

		// The lit pipelines' alone, nil in the unlit one. mbsc's names (tools/mbsc/lighting.odin)
		view_uniform:^sce.GxmProgramParameter, // the vertex program's: eye space
		// The fragment program's per pixel and the vertex program's per vertex
		lights:Light_Parameters,

		// The skinned shaders' alone, nil in the others: the joint palette as three arrays of float4, `mbi.skin_settings.joint_limit` each
		skin_row0_uniform:^sce.GxmProgramParameter,
		skin_row1_uniform:^sce.GxmProgramParameter,
		skin_row2_uniform:^sce.GxmProgramParameter,

		white_texture:gfx.Texture, // bound for untextured draws: the shader always samples. mbi.pipeline's serves both

		// A game shader's alone (shader_vita_freestanding_arm32.odin); nil in the built-ins, which use the fields above
		game:^Game_Bindings,
	}

	/*
		Copies vertices and indices into GPU-mapped memory, one block for both: gfx.alloc rounds
		every block up to 4 KiB, so two per mesh would waste twice as much. The slices can be
		freed afterwards
	*/
	create_mesh :: proc(vertices:[]Vertex, indices:[]u16) -> (mesh:Mesh) {
		return create_mesh_from_bytes(mem.slice_to_bytes(vertices), len(vertices), indices)
	}

	/*Copies vertices with normals and indices into GPU-mapped memory, for a model part. The slices can be freed afterwards*/
	create_lit_mesh :: proc(vertices:[]Lit_Vertex, indices:[]u16) -> (mesh:Mesh) {
		mesh = create_mesh_from_bytes(mem.slice_to_bytes(vertices), len(vertices), indices)
		mesh.lit = true
		return
	}

	/*Copies skinned vertices and indices into GPU-mapped memory, for a skinned model part. The slices can be freed afterwards*/
	create_skinned_mesh :: proc(vertices:[]Skinned_Vertex, indices:[]u16) -> (mesh:Mesh) {
		mesh = create_mesh_from_bytes(mem.slice_to_bytes(vertices), len(vertices), indices)
		mesh.lit = true
		mesh.skinned = true
		return
	}

	/*The three kinds of mesh differ only in how many bytes a vertex has; the memory is filled the same way*/
	@(private = "file")
	create_mesh_from_bytes :: proc(vertex_bytes:[]u8, vertex_count:int, indices:[]u16) -> (mesh:Mesh) {
		assert(vertex_count > 0 && len(indices) > 0, "A mesh needs vertices and indices")
		assert(vertex_count <= 65536, "A mesh with 16-bit indices can have at most 65536 vertices")

		vertex_size := len(vertex_bytes) // a multiple of 4, so the indices after it are aligned
		index_size := len(indices) * size_of(u16)
		memory, uid := gfx.alloc(uint(vertex_size + index_size))
		ensure(memory != nil, "Out of GPU memory for a mesh")

		mesh.vertices = memory
		mesh.indices = rawptr(uintptr(memory) + uintptr(vertex_size))
		mesh.index_count = u32(len(indices))
		mesh.uid = uid
		// Uncached memory (gfx.alloc's default): no cache flush, unlike the 3DS
		mem.copy(mesh.vertices, raw_data(vertex_bytes), vertex_size)
		mem.copy(mesh.indices, raw_data(indices), index_size)
		return
	}

	/*
		Waits for the GPU first: a mesh destroyed the frame after it was drawn may still be read.
		finish waits for everything, which is slow, but destroying a mesh is rare
	*/
	destroy_mesh :: proc(mesh:Mesh) {
		if mesh.vertices == nil do return
		gfx.finish()
		gfx.free(mesh.uid)
	}

	/*What render.odin's sort groups opaque items by: texture, then mesh*/
	@(private)
	calculate_render_item_sort_key :: proc(item:Render_Item) -> [2]uintptr {
		return {uintptr(item.texture.texture), uintptr(item.mesh.vertices)}
	}

	/*
		Registers both shaders, makes their programs and finds their uniforms. Called once from
		init. Anything missing stops here with a message: a pipeline that half-loaded would draw
		nothing, with no sign why
	*/
	@(private)
	create_render_pipeline :: proc() {
		load_render_pipeline(&mbi.pipeline, #load("shaders/mesh_v.gxp"), #load("shaders/mesh_f.gxp"), nil)
		load_render_pipeline(&mbi.lit_pipeline, #load("shaders/mesh_lit_v.gxp"), #load("shaders/mesh_lit_f.gxp"), .PER_PIXEL)
		// The same vertex program: the copy differs only in having no `discard`, which the fragment stage alone holds
		load_render_pipeline(&mbi.lit_opaque_pipeline, #load("shaders/mesh_lit_v.gxp"), #load("shaders/mesh_lit_opaque_f.gxp"), .PER_PIXEL, has_alpha_test = false)
		load_render_pipeline(&mbi.vertex_lit_pipeline, #load("shaders/mesh_vertex_lit_v.gxp"), #load("shaders/mesh_vertex_lit_f.gxp"), .PER_VERTEX)
		print("pipelines: plain ones made, making the skinned ones")
		load_render_pipeline(&mbi.skinned_pipeline, #load("shaders/mesh_skinned_v.gxp"), #load("shaders/mesh_skinned_f.gxp"), nil, skinned = true)
		load_render_pipeline(&mbi.skinned_lit_pipeline, #load("shaders/mesh_skinned_lit_v.gxp"), #load("shaders/mesh_skinned_lit_f.gxp"), .PER_PIXEL, skinned = true)
		print("pipelines: skinned ones made")

		// 8 x 8 because a linear texture's rows are padded to 8 pixels anyway
		ok:bool
		mbi.pipeline.white_texture, ok = gfx.create_texture(8, 8, .POINT, .CLAMP)
		if !ok do fail_pipeline("Could not make the white texture")
		for i in 0 ..< 64 do mbi.pipeline.white_texture.pixels[i] = 0xFFFFFFFF
	}

	/*Registers one shader's two programs, makes its vertex and fragment programs and finds its uniforms*/
	@(private = "file")
	load_render_pipeline :: proc(pipeline:^Render_Pipeline, vertex_gxp:[]u8, fragment_gxp:[]u8, lighting:Maybe(Lighting_Mode), has_alpha_test := true, skinned := false) {
		pipeline.lighting = lighting
		pipeline.skinned = skinned
		ok:bool
		pipeline.vertex_shader, ok = gfx.register_program(vertex_gxp)
		if !ok do fail_pipeline("A vertex .gxp could not be registered")
		pipeline.fragment_shader, ok = gfx.register_program(fragment_gxp)
		if !ok do fail_pipeline("A fragment .gxp could not be registered")

		// The names are the Cg main's parameters (<name>_v.cg), in Vertex's field order, with
		// Lit_Vertex's normal after them in the lit shaders
		vertex := pipeline.vertex_shader
		if skinned {
			// Joints are whole numbers 0 to 255 for the program to use as an index; weights are normalised to 0 to 1
			attributes: [6]sce.GxmVertexAttribute
			count := 0
			// psp2cgc drops an input the shader never reads: the unlit skinned shader has no a_normal. gfx.attribute gives a
			// missing one register 0, which is a_position's. Vita3K accepts two attributes on one register where real GXM
			// may not (the real Vita crashed), so an input the program dropped is left out of the attribute list
			add :: proc(attributes:^[6]sce.GxmVertexAttribute, count:^int, program:gfx.Program, name:cstring, offset:uintptr, format:u8, components:u8) {
				if gfx.parameter(program, name) == nil do return
				attributes[count^] = gfx.attribute(program, name, u16(offset), format, components)
				count^ += 1
			}
			add(&attributes, &count, vertex, "a_position", offset_of(Lit_Vertex, position), sce.GXM_ATTRIBUTE_FORMAT_F32, 3)
			add(&attributes, &count, vertex, "a_texcoord", offset_of(Lit_Vertex, uv), sce.GXM_ATTRIBUTE_FORMAT_F32, 2)
			add(&attributes, &count, vertex, "a_color", offset_of(Lit_Vertex, color), sce.GXM_ATTRIBUTE_FORMAT_F32, 4)
			add(&attributes, &count, vertex, "a_normal", offset_of(Lit_Vertex, normal), sce.GXM_ATTRIBUTE_FORMAT_F32, 3)
			add(&attributes, &count, vertex, "a_joints", offset_of(Skinned_Vertex, joints), sce.GXM_ATTRIBUTE_FORMAT_U8, 4)
			add(&attributes, &count, vertex, "a_weights", offset_of(Skinned_Vertex, weights), sce.GXM_ATTRIBUTE_FORMAT_U8N, 4)
			pipeline.vertex_program = gfx.create_vertex_program(vertex, attributes[:count], size_of(Skinned_Vertex))
			if pipeline.vertex_program == nil do fail_pipeline("The skinned mesh vertex program could not be made")
		} else if lighting != nil {
			attributes := [?]sce.GxmVertexAttribute {
				gfx.attribute(vertex, "a_position", u16(offset_of(Lit_Vertex, position)), sce.GXM_ATTRIBUTE_FORMAT_F32, 3),
				gfx.attribute(vertex, "a_texcoord", u16(offset_of(Lit_Vertex, uv)), sce.GXM_ATTRIBUTE_FORMAT_F32, 2),
				gfx.attribute(vertex, "a_color", u16(offset_of(Lit_Vertex, color)), sce.GXM_ATTRIBUTE_FORMAT_F32, 4),
				gfx.attribute(vertex, "a_normal", u16(offset_of(Lit_Vertex, normal)), sce.GXM_ATTRIBUTE_FORMAT_F32, 3),
			}
			pipeline.vertex_program = gfx.create_vertex_program(vertex, attributes[:], size_of(Lit_Vertex))
			if pipeline.vertex_program == nil do fail_pipeline("The lit mesh vertex program could not be made")
		} else {
			attributes := [?]sce.GxmVertexAttribute {
				gfx.attribute(vertex, "a_position", u16(offset_of(Vertex, position)), sce.GXM_ATTRIBUTE_FORMAT_F32, 3),
				gfx.attribute(vertex, "a_texcoord", u16(offset_of(Vertex, uv)), sce.GXM_ATTRIBUTE_FORMAT_F32, 2),
				gfx.attribute(vertex, "a_color", u16(offset_of(Vertex, color)), sce.GXM_ATTRIBUTE_FORMAT_F32, 4),
			}
			pipeline.vertex_program = gfx.create_vertex_program(vertex, attributes[:], size_of(Vertex))
			if pipeline.vertex_program == nil do fail_pipeline("The mesh vertex program could not be made")
			// A lit mesh's vertices start with a whole Vertex, so the same attributes read it with the longer stride
			pipeline.lit_vertex_program = gfx.create_vertex_program(vertex, attributes[:], size_of(Lit_Vertex))
			if pipeline.lit_vertex_program == nil do fail_pipeline("The unlit program for lit meshes could not be made")
		}

		blends := [Blend_Mode]gfx.Blend {
			.NONE = .None,
			.ALPHA = .Alpha,
		}
		for blend, mode in blends {
			pipeline.fragment_programs[mode] = gfx.create_fragment_program(pipeline.fragment_shader, vertex, blend)
			if pipeline.fragment_programs[mode] == nil do fail_pipeline("A mesh fragment program could not be made")
		}

		find :: proc(program:gfx.Program, name:cstring) -> ^sce.GxmProgramParameter {
			parameter := gfx.parameter(program, name)
			if parameter == nil {
				// psp2cgc drops a uniform the shader never reads, so this is also what a
				// shader that stopped using one looks like
				print("a mesh .gxp has no uniform", name)
				panic("A uniform the engine sets is missing from a mesh shader")
			}
			return parameter
		}
		pipeline.view_projection_uniform = find(vertex, "frame_view_projection")
		pipeline.model_uniform = find(vertex, "render_model")
		pipeline.tint_uniform = find(vertex, "render_tint")
		pipeline.uv_rectangle_uniform = find(vertex, "render_uv_rectangle")
		// The shader without the test never reads the cutoff, so psp2cgc leaves it out: nil, and render_item skips it
		if has_alpha_test do pipeline.alpha_cutoff_uniform = find(pipeline.fragment_shader, "render_alpha_cutoff")
		pipeline.texture_unit = gfx.texture_unit(pipeline.fragment_shader, "tex")
		if skinned {
			pipeline.skin_row0_uniform = find(vertex, "skin_row0")
			pipeline.skin_row1_uniform = find(vertex, "skin_row1")
			pipeline.skin_row2_uniform = find(vertex, "skin_row2")
		}
		if mode, lit := lighting.?; lit {
			pipeline.view_uniform = find(vertex, "frame_view")
			// psp2cgc keeps a uniform only in the program that reads it: the fragment one per pixel, the vertex
			// one per vertex
			reads := pipeline.fragment_shader if mode == .PER_PIXEL else vertex
			pipeline.lights.ambient = find(reads, "lights_ambient")
			pipeline.lights.direction = find(reads, "lights_direction")
			pipeline.lights.diffuse = find(reads, "lights_diffuse")
			pipeline.lights.specular = find(reads, "lights_specular")
			pipeline.lights.position = find(reads, "lights_position")
			pipeline.lights.cone = find(reads, "lights_cone")
			if mode == .PER_PIXEL do pipeline.lights.split = find(reads, "lights_split")
			pipeline.lights.shininess = find(reads, "render_shininess")
			pipeline.lights.specular_strength = find(reads, "render_specular_strength")
		}
	}

	/*
		Makes a Render_Pipeline for a GAME shader from the bytes of its two .gxp files and the text of its .vita.refl (docs/shader_cg.md,
		"Vita reflection"), the same programs the built-ins have: one vertex program for the mesh layout it reads, and one fragment
		program per blend mode. What differs from load_render_pipeline, which reads nothing but its arguments and stops on any
		engine uniform that is missing:
		- every engine uniform is optional, because psp2cgc drops one the program never reads, and each may be in either program
		  (Dual_Parameter), so a missing one is nil and every write skips it. Only the built-ins stop on a missing uniform: their
		  shader is the engine's own, so a missing one is a bug in the engine, not a choice the shader made
		- the vertex inputs are the ones the reflection lists AND the program kept. An input psp2cgc dropped is left out: gfx.attribute
		  gives a missing one register 0, which another attribute owns, and Vita3K accepts two attributes on one register where
		  real GXM crashed (see the skinned built-ins)
		- a normal in the reflection means the Lit_Vertex layout, whether or not the shader reads the lights
		- the texture units come from the program, by the names the reflection lists, not from a fixed "tex"
		The programs register a copy of the bytes (gfx.register_program), so the slices need not outlive the call; the reflection's
		strings are only read here, and its game entries' names are kept by the caller. Anything the engine cannot honour stops
		with a message, as in load_render_pipeline
	*/
	@(private)
	create_game_render_pipeline :: proc(vertex_gxp:[]u8, fragment_gxp:[]u8, reflection:^Vita_Reflection, game_entries:[]Vita_Game_Entry, skinned:bool) -> (pipeline:Render_Pipeline) {
		pipeline.skinned = skinned
		ok:bool
		pipeline.vertex_shader, ok = gfx.register_program(vertex_gxp)
		if !ok do fail_pipeline("A game vertex .gxp could not be registered")
		pipeline.fragment_shader, ok = gfx.register_program(fragment_gxp)
		if !ok do fail_pipeline("A game fragment .gxp could not be registered")
		vertex := pipeline.vertex_shader
		fragment := pipeline.fragment_shader
		reads_normal := vita_reads_normal(reflection)

		attributes:[6]sce.GxmVertexAttribute
		count := 0
		for attribute in reflection.attributes {
			offset:uintptr
			format, components:u8
			switch attribute.name {
			case "position": offset, format, components = offset_of(Lit_Vertex, position), sce.GXM_ATTRIBUTE_FORMAT_F32, 3
			case "texcoord": offset, format, components = offset_of(Lit_Vertex, uv), sce.GXM_ATTRIBUTE_FORMAT_F32, 2
			case "color":    offset, format, components = offset_of(Lit_Vertex, color), sce.GXM_ATTRIBUTE_FORMAT_F32, 4
			case "normal":   offset, format, components = offset_of(Lit_Vertex, normal), sce.GXM_ATTRIBUTE_FORMAT_F32, 3
			// Joints are whole numbers 0 to 255 for the program to use as an index; weights are normalised to 0 to 1
			case "joints":   offset, format, components = offset_of(Skinned_Vertex, joints), sce.GXM_ATTRIBUTE_FORMAT_U8, 4
			case "weights":  offset, format, components = offset_of(Skinned_Vertex, weights), sce.GXM_ATTRIBUTE_FORMAT_U8N, 4
			case:
				print("a game shader reads a vertex input the engine has no data for:", attribute.name)
				fail_pipeline("A game shader reads a vertex input the engine's meshes do not have")
			}
			if !skinned && (attribute.name == "joints" || attribute.name == "weights") {
				print("a game shader that is not a _skinned variant reads", attribute.name)
				fail_pipeline("Only a _skinned game shader may read joints and weights")
			}
			name := get_parameter_name("a_", attribute.name)
			if gfx.parameter(vertex, name) == nil do continue // dropped by psp2cgc: left out, see above
			attributes[count] = gfx.attribute(vertex, name, u16(offset), format, components)
			count += 1
		}
		if count == 0 do fail_pipeline("A game vertex program keeps none of the vertex inputs")

		if skinned {
			pipeline.vertex_program = gfx.create_vertex_program(vertex, attributes[:count], size_of(Skinned_Vertex))
		} else if reads_normal {
			pipeline.vertex_program = gfx.create_vertex_program(vertex, attributes[:count], size_of(Lit_Vertex))
		} else {
			pipeline.vertex_program = gfx.create_vertex_program(vertex, attributes[:count], size_of(Vertex))
			// A lit mesh's vertices start with a whole Vertex, so the same attributes read it with the longer stride
			pipeline.lit_vertex_program = gfx.create_vertex_program(vertex, attributes[:count], size_of(Lit_Vertex))
			if pipeline.lit_vertex_program == nil do fail_pipeline("The game shader's program for lit meshes could not be made")
		}
		if pipeline.vertex_program == nil do fail_pipeline("A game vertex program could not be made")

		blends := [Blend_Mode]gfx.Blend {
			.NONE = .None,
			.ALPHA = .Alpha,
		}
		for blend, mode in blends {
			pipeline.fragment_programs[mode] = gfx.create_fragment_program(fragment, vertex, blend)
			if pipeline.fragment_programs[mode] == nil do fail_pipeline("A game fragment program could not be made")
		}

		bindings := new(Game_Bindings)
		pipeline.game = bindings
		find :: proc(pipeline:^Render_Pipeline, name:cstring) -> Dual_Parameter {
			return {vertex = gfx.parameter(pipeline.vertex_shader, name), fragment = gfx.parameter(pipeline.fragment_shader, name)}
		}
		bindings.engine[.VIEW_PROJECTION] = find(&pipeline, "frame_view_projection")
		bindings.engine[.VIEW] = find(&pipeline, "frame_view")
		bindings.engine[.MODEL] = find(&pipeline, "render_model")
		bindings.engine[.TINT] = find(&pipeline, "render_tint")
		bindings.engine[.UV_RECTANGLE] = find(&pipeline, "render_uv_rectangle")
		bindings.engine[.ALPHA_CUTOFF] = find(&pipeline, "render_alpha_cutoff")
		bindings.engine[.TIME] = find(&pipeline, "frame_time")
		bindings.engine[.SKIN_ROW0] = find(&pipeline, "skin_row0")
		bindings.engine[.SKIN_ROW1] = find(&pipeline, "skin_row1")
		bindings.engine[.SKIN_ROW2] = find(&pipeline, "skin_row2")

		// The same names the built-in lit shaders use, wherever this program has them. The block is written to both programs
		// and each takes what it holds
		find_lights :: proc(program:gfx.Program) -> (lights:Light_Parameters, reads:bool) {
			lights.ambient = gfx.parameter(program, "lights_ambient")
			lights.direction = gfx.parameter(program, "lights_direction")
			lights.diffuse = gfx.parameter(program, "lights_diffuse")
			lights.specular = gfx.parameter(program, "lights_specular")
			lights.position = gfx.parameter(program, "lights_position")
			lights.cone = gfx.parameter(program, "lights_cone")
			lights.split = gfx.parameter(program, "lights_split")
			lights.shininess = gfx.parameter(program, "render_shininess")
			lights.specular_strength = gfx.parameter(program, "render_specular_strength")
			reads = lights.ambient != nil || lights.direction != nil || lights.diffuse != nil || lights.specular != nil || lights.position != nil || lights.cone != nil || lights.split != nil
			return
		}
		vertex_reads, fragment_reads:bool
		bindings.vertex_lights, vertex_reads = find_lights(vertex)
		bindings.fragment_lights, fragment_reads = find_lights(fragment)
		bindings.reads_lights = vertex_reads || fragment_reads

		bindings.uniforms = make([]Dual_Parameter, len(game_entries))
		missing := 0
		for entry, index in game_entries {
			bindings.uniforms[index] = find(&pipeline, get_parameter_name("", entry.name))
			if bindings.uniforms[index].vertex == nil && bindings.uniforms[index].fragment == nil {
				// Not an error: psp2cgc drops a uniform no code reaches. Printed so a name the compiler spelled differently shows up
				missing += 1
				print("a game uniform is in neither program:", entry.name)
			}
		}

		for texture in reflection.textures {
			if bindings.texture_count == len(bindings.texture_units) do break
			name := get_parameter_name("", texture.name)
			if gfx.parameter(fragment, name) == nil do continue // a sampler the program never reads is dropped too
			bindings.texture_units[bindings.texture_count] = gfx.texture_unit(fragment, name)
			bindings.texture_count += 1
		}

		print("game pipeline:", len(reflection.attributes), "inputs,", count, "kept; game uniforms", len(game_entries), "missing", missing, "; textures", bindings.texture_count, "; lights", bindings.reads_lights)
		return
	}

	/*`prefix` and `name` as one null-terminated string, on the temp allocator: gfx.parameter takes a cstring*/
	@(private = "file")
	get_parameter_name :: proc(prefix:string, name:string) -> cstring {
		joined, _ := strings.concatenate({prefix, name}, context.temp_allocator)
		text, _ := strings.clone_to_cstring(joined, context.temp_allocator)
		return text
	}

	/*Gives back a game pipeline's programs. The GPU must be idle: the caller waits first (destroy_shader)*/
	@(private)
	destroy_game_render_pipeline :: proc(pipeline:^Render_Pipeline) {
		unload_render_pipeline(pipeline)
		if pipeline.game != nil {
			delete(pipeline.game.uniforms)
			free(pipeline.game)
		}
		pipeline^ = {}
	}

	/*
		Draws one item with a game shader: the same writes as the built-ins' render_item, but each to whichever program holds
		the uniform, and then the game's own uniforms from the shader's CPU copy. Every uniform is written on every draw,
		because use_programs reserves fresh buffers for it
	*/
	@(private = "file")
	render_game_item :: proc(item:Render_Item, blend:Blend_Mode, data:^Shader_Data, pipeline:^Render_Pipeline) {
		bindings := pipeline.game
		vertex_program := pipeline.vertex_program
		// A shader that does not read the normal still draws lit meshes, through the program with their stride
		if item.mesh.lit && !item.mesh.skinned && pipeline.lit_vertex_program != nil do vertex_program = pipeline.lit_vertex_program
		vertex_uniforms, fragment_uniforms := gfx.use_programs(vertex_program, pipeline.fragment_programs[blend])

		write_dual :: proc(vertex_uniforms:rawptr, fragment_uniforms:rawptr, parameter:Dual_Parameter, values:[]f32) {
			gfx.set_uniform(vertex_uniforms, parameter.vertex, values)
			gfx.set_uniform(fragment_uniforms, parameter.fragment, values)
		}
		write_dual_matrix :: proc(vertex_uniforms:rawptr, fragment_uniforms:rawptr, parameter:Dual_Parameter, matrix_value:^matrix[4, 4]f32) {
			gfx.set_uniform_matrix(vertex_uniforms, parameter.vertex, matrix_value)
			gfx.set_uniform_matrix(fragment_uniforms, parameter.fragment, matrix_value)
		}

		model := item.model
		tint := item.tint
		uv := item.uv_rectangle
		cutoff := item.alpha_cutoff
		seconds := f32(get_time())
		write_dual_matrix(vertex_uniforms, fragment_uniforms, bindings.engine[.VIEW_PROJECTION], &mbi.camera_view_projection)
		write_dual_matrix(vertex_uniforms, fragment_uniforms, bindings.engine[.VIEW], &mbi.view)
		write_dual_matrix(vertex_uniforms, fragment_uniforms, bindings.engine[.MODEL], &model)
		write_dual(vertex_uniforms, fragment_uniforms, bindings.engine[.TINT], tint[:])
		write_dual(vertex_uniforms, fragment_uniforms, bindings.engine[.UV_RECTANGLE], uv[:])
		write_dual(vertex_uniforms, fragment_uniforms, bindings.engine[.ALPHA_CUTOFF], ([^]f32)(&cutoff)[:1])
		write_dual(vertex_uniforms, fragment_uniforms, bindings.engine[.TIME], ([^]f32)(&seconds)[:1])
		// The lights are this camera's, filled at camera_end while lighting is on; a shader that reads them is not drawn otherwise
		// (choose_game_shader). The material is written either way: it is per part, not per light
		write_light_parameters(&bindings.vertex_lights, vertex_uniforms, item.material)
		write_light_parameters(&bindings.fragment_lights, fragment_uniforms, item.material)
		if item.mesh.skinned {
			rows := get_skin_rows(item)
			limit := mbi.skin_settings.joint_limit
			write_dual(vertex_uniforms, fragment_uniforms, bindings.engine[.SKIN_ROW0], ([^]f32)(raw_data(rows))[:4 * limit])
			write_dual(vertex_uniforms, fragment_uniforms, bindings.engine[.SKIN_ROW1], ([^]f32)(raw_data(rows[limit:]))[:4 * limit])
			write_dual(vertex_uniforms, fragment_uniforms, bindings.engine[.SKIN_ROW2], ([^]f32)(raw_data(rows[2 * limit:]))[:4 * limit])
		}

		game := &data.game
		for entry, index in game.entries {
			write_dual(vertex_uniforms, fragment_uniforms, bindings.uniforms[index], game.values[entry.offset:][:entry.floats])
		}
		game.dirty = false

		// The draw's texture goes to the first sampler the shader kept; any others get plain white, which leaves the colour as it is
		// when it is multiplied in (as on PC)
		for index in 0 ..< bindings.texture_count {
			texture := item.texture.texture if index == 0 else nil
			if texture == nil do texture = &mbi.pipeline.white_texture
			sce.sceGxmSetFragmentTexture(gfx.ctx, bindings.texture_units[index], &texture.texture)
		}
		sce.sceGxmSetVertexStream(gfx.ctx, 0, item.mesh.vertices)
		sce.sceGxmDraw(gfx.ctx, .TRIANGLES, .U16, item.mesh.indices, item.mesh.index_count)
	}

	/*The SCE error says why, and it is lost unless printed before stopping*/
	@(private)
	fail_pipeline :: proc(message:string) -> ! {
		print(message, "error", gfx.last_program_error, "alloc error", gfx.last_alloc_error)
		panic(message)
	}

	@(private = "file")
	unload_render_pipeline :: proc(pipeline:^Render_Pipeline) {
		for program in pipeline.fragment_programs {
			if program != nil do sce.sceGxmShaderPatcherReleaseFragmentProgram(gfx.patcher, program)
		}
		if pipeline.vertex_program != nil do sce.sceGxmShaderPatcherReleaseVertexProgram(gfx.patcher, pipeline.vertex_program)
		if pipeline.lit_vertex_program != nil do sce.sceGxmShaderPatcherReleaseVertexProgram(gfx.patcher, pipeline.lit_vertex_program)
		gfx.unregister_program(&pipeline.fragment_shader)
		gfx.unregister_program(&pipeline.vertex_shader)
	}

	/*The GPU must be idle (cleanup calls gfx.finish first)*/
	@(private)
	destroy_render_pipeline :: proc() {
		gfx.destroy_texture(&mbi.pipeline.white_texture)
		unload_render_pipeline(&mbi.skinned_lit_pipeline)
		unload_render_pipeline(&mbi.skinned_pipeline)
		unload_render_pipeline(&mbi.vertex_lit_pipeline)
		unload_render_pipeline(&mbi.lit_opaque_pipeline)
		unload_render_pipeline(&mbi.lit_pipeline)
		unload_render_pipeline(&mbi.pipeline)
		delete(mbi.opaque_items)
		delete(mbi.transparent_items)
	}

	/*
		Issues the draw call for one queued item. use_programs reserves this draw's uniform
		buffers, so every uniform is written each time, the camera's and the lights included. A
		lit mesh is drawn lit only while lighting is on, per pixel or per vertex as its material
		says, as on PC; off, it goes through the unlit shader's program for Lit_Vertex
	*/
	@(private)
	render_item :: proc(item:Render_Item, blend:Blend_Mode) {
		// A game shader replaces the built-in for the meshes it has a pipeline for (shader_vita_freestanding_arm32.odin)
		if data, pipeline := choose_game_shader(item); pipeline != nil {
			render_game_item(item, blend, data, pipeline)
			return
		}
		lit := item.mesh.lit && mbi.lighting.settings.enabled
		pipeline := &mbi.pipeline
		if lit {
			switch get_lighting_mode(item.material) {
			// A discard in a fragment program makes the GPU shade pixels it could have rejected as hidden, which the
			// big flat part of a scene pays for (measured on a Vita: 24 fps with it, 28 without); a part with no
			// cut-out takes the program without one
			case .PER_PIXEL:  pipeline = &mbi.lit_pipeline if item.alpha_cutoff > 0 else &mbi.lit_opaque_pipeline
			case .PER_VERTEX: pipeline = &mbi.vertex_lit_pipeline
			}
		}
		if item.mesh.skinned do pipeline = &mbi.skinned_lit_pipeline if lit else &mbi.skinned_pipeline
		vertex_program := pipeline.vertex_program
		if !lit && item.mesh.lit && !item.mesh.skinned do vertex_program = pipeline.lit_vertex_program
		vertex_uniforms, fragment_uniforms := gfx.use_programs(vertex_program, pipeline.fragment_programs[blend])

		// Odin's matrix memory goes in unchanged: mbsc wrote the Cg with mul(v, m) to match
		// (docs/shader_cg.md, "Matrices")
		model := item.model
		gfx.set_uniform_matrix(vertex_uniforms, pipeline.view_projection_uniform, &mbi.camera_view_projection)
		gfx.set_uniform_matrix(vertex_uniforms, pipeline.model_uniform, &model)
		tint := item.tint
		uv := item.uv_rectangle
		cutoff := item.alpha_cutoff
		gfx.set_uniform(vertex_uniforms, pipeline.tint_uniform, tint[:])
		gfx.set_uniform(vertex_uniforms, pipeline.uv_rectangle_uniform, uv[:])
		if pipeline.alpha_cutoff_uniform != nil do gfx.set_uniform(fragment_uniforms, pipeline.alpha_cutoff_uniform, ([^]f32)(&cutoff)[:1])
		if lit do set_light_uniforms(pipeline, vertex_uniforms, fragment_uniforms, item.material)
		if item.mesh.skinned {
			// The three row arrays, padded with the identity to the limit (get_skin_rows)
			rows := get_skin_rows(item)
			limit := mbi.skin_settings.joint_limit
			gfx.set_uniform(vertex_uniforms, pipeline.skin_row0_uniform, ([^]f32)(raw_data(rows))[:4 * limit])
			gfx.set_uniform(vertex_uniforms, pipeline.skin_row1_uniform, ([^]f32)(raw_data(rows[limit:]))[:4 * limit])
			gfx.set_uniform(vertex_uniforms, pipeline.skin_row2_uniform, ([^]f32)(raw_data(rows[2 * limit:]))[:4 * limit])
		}

		// No texture is white, as on PC: the shader always samples, and white times the tint is the tint
		texture := item.texture.texture if item.texture.texture != nil else &mbi.pipeline.white_texture
		sce.sceGxmSetFragmentTexture(gfx.ctx, pipeline.texture_unit, &texture.texture)
		sce.sceGxmSetVertexStream(gfx.ctx, 0, item.mesh.vertices)
		sce.sceGxmDraw(gfx.ctx, .TRIANGLES, .U16, item.mesh.indices, item.mesh.index_count)
	}

	/*
		Writes what a lit shader reads besides the common uniforms: the camera's view for eye
		space, this camera's lights (filled at camera_end), and the part's material, into the
		program that reads them: the fragment one per pixel, the vertex one per vertex. The per-pixel
		loops run the sorted block's runs, sent as three floats; the per-vertex loop runs all 8 and
		has no counts (tools/mbsc/lighting.odin)
	*/
	@(private = "file")
	set_light_uniforms :: proc(pipeline:^Render_Pipeline, vertex_uniforms:rawptr, fragment_uniforms:rawptr, material:Material) {
		gfx.set_uniform_matrix(vertex_uniforms, pipeline.view_uniform, &mbi.view)
		buffer := fragment_uniforms if pipeline.lighting == .PER_PIXEL else vertex_uniforms
		write_light_parameters(&pipeline.lights, buffer, material)
	}

	/*Writes this camera's lights and a part's material into one program's buffer, to whichever of the uniforms that program holds (a nil one is skipped)*/
	@(private = "file")
	write_light_parameters :: proc(parameters:^Light_Parameters, buffer:rawptr, material:Material) {
		lights := &mbi.camera_lights
		gfx.set_uniform(buffer, parameters.ambient, lights.ambient[:])
		gfx.set_uniform(buffer, parameters.direction, ([^]f32)(&lights.direction)[:4 * LIGHT_SLOT_COUNT])
		gfx.set_uniform(buffer, parameters.diffuse, ([^]f32)(&lights.diffuse)[:4 * LIGHT_SLOT_COUNT])
		gfx.set_uniform(buffer, parameters.specular, ([^]f32)(&lights.specular)[:4 * LIGHT_SLOT_COUNT])
		gfx.set_uniform(buffer, parameters.position, ([^]f32)(&lights.position)[:4 * LIGHT_SLOT_COUNT])
		gfx.set_uniform(buffer, parameters.cone, ([^]f32)(&lights.cone)[:4 * LIGHT_SLOT_COUNT])
		if parameters.split != nil {
			split := [3]f32{f32(lights.sun_count), f32(lights.sun_count + lights.point_count), f32(lights.count)}
			gfx.set_uniform(buffer, parameters.split, split[:])
		}
		shininess := material.shininess
		strength := material.specular_strength
		gfx.set_uniform(buffer, parameters.shininess, ([^]f32)(&shininess)[:1])
		gfx.set_uniform(buffer, parameters.specular_strength, ([^]f32)(&strength)[:1])
	}

	/*
		Sets the depth test for one draw. LESS as on PC: gfx.set_viewport puts near at 0 and the
		surface starts every scene at 1, so smaller is nearer. The 3DS is the one that is reversed
	*/
	@(private)
	set_depth_mode :: proc(depth:Depth_Mode) {
		switch depth {
		case .OPAQUE:
			sce.sceGxmSetFrontDepthFunc(gfx.ctx, .LESS)
			sce.sceGxmSetFrontDepthWriteEnable(gfx.ctx, .ENABLED)
		case .TRANSPARENT:
			sce.sceGxmSetFrontDepthFunc(gfx.ctx, .LESS)
			sce.sceGxmSetFrontDepthWriteEnable(gfx.ctx, .DISABLED)
		case .DISABLED:
			sce.sceGxmSetFrontDepthFunc(gfx.ctx, .ALWAYS)
			sce.sceGxmSetFrontDepthWriteEnable(gfx.ctx, .DISABLED)
		}
	}

	/*
		Skips triangles facing away for .BACK. PC and the 3DS treat counter-clockwise as front, so
		clockwise is what gets culled. gfx.set_viewport flips y, which made it unclear whether GXM
		judges winding before or after the flip: the V4 test answered it (a clockwise triangle is
		culled with .CW, a counter-clockwise one draws), checked in Vita3K, not yet on hardware
	*/
	@(private)
	set_cull_mode :: proc(cull:Cull_Mode) {
		switch cull {
		case .BACK: sce.sceGxmSetCullMode(gfx.ctx, .CW)
		case .NONE: sce.sceGxmSetCullMode(gfx.ctx, .NONE)
		}
	}

	/*Only the 3DS measures the GPU's time (render_3ds_freestanding_arm32.odin); the Vita answers {0, 0}*/
	get_gpu_times :: proc() -> [2]f32 {
		return {}
	}

	render_start :: proc() {
		mbi.screen_scene_open = false
		mbi.pending_clear = nil
		begin_internal_frame() // a game with set_internal_resolution on draws into its target from here
	}

	/*
		Opens the screen's scene if it is not open. GXM cannot interleave scenes, so it waits for the first thing
		drawn to the screen (or render_end), after every render target has had its own. A clear_background that came
		first is applied here
	*/
	@(private)
	ensure_screen_scene :: proc() {
		if mbi.screen_scene_open do return
		gfx.begin_frame()
		mbi.screen_scene_open = true
		if color, ok := mbi.pending_clear.?; ok do gfx.clear(color)
		mbi.pending_clear = nil
	}

	/*Renders final output -- ends the scene and queues it for display, which waits for vsync*/
	render_end :: proc() {
		ensure(mbi.render_target_state.is_active == false || mbi.render_target_state.internal_frame, "render_target_end was not called before render_end")
		end_internal_frame()
		ensure_screen_scene() // a frame that drew nothing to the screen still has to be presented
		gfx.end_frame()
		gfx.swap()
	}

	/*
		Everything drawn until camera_end is seen through this camera. Records the same state
		the PC's does, so the shared queue (render.odin) fills exactly as it does there
	*/
	camera_start :: proc(camera:Camera) {
		ensure(mbi.camera_active == false, "camera_start called again before camera_end")

		check_camera_destination(camera)
		draw_size := get_draw_size()
		window := [2]f32{f32(draw_size.x), f32(draw_size.y)}
		used := calculate_camera_snapped(camera, window)
		mbi.pixel_scale = calculate_camera_snap_scale(camera, window.y)

		mbi.view = calculate_camera_view_matrix(used)
		mbi.camera_active = true
		mbi.screen_pass = camera.screen
		mbi.camera_fov_y = used.fov_y if used.projection == .PERSPECTIVE else 0 // billboards read these two (billboard.odin)
		mbi.camera_window_height = window.y
		// While the bottom screen fills the screen, the world and HUD are not shown. As on PC
		mbi.discard_pass = is_top_screen_hidden()

		// gfx.set_viewport maps clip z -1..1 onto depth 0..1, so linalg's GL projection goes in
		// as it is: no remap, unlike D3D and the PICA
		mbi.camera_view_projection = calculate_camera_projection_gl(used, window.x / window.y) * mbi.view
	}

	/*Sorts and draws everything queued since camera_start*/
	camera_end :: proc() {
		ensure(mbi.camera_active == true, "camera_end called without camera_start")
		defer {
			clear(&mbi.opaque_items)
			clear(&mbi.transparent_items)
			clear(&mbi.skin_state.rows)
			mbi.camera_active = false
			mbi.screen_pass = false
			mbi.discard_pass = false
		}

		// A hidden pass was queued but is never drawn
		if mbi.discard_pass == true do return
		note_screen_drawn()
		if mbi.render_target_state.is_active == false do ensure_screen_scene()

		// A screen camera has no depth buffer to lean on, so what is drawn last lands on top
		depth_opaque := Depth_Mode.OPAQUE
		depth_transparent := Depth_Mode.TRANSPARENT
		if mbi.screen_pass == true {
			depth_opaque = .DISABLED
			depth_transparent = .DISABLED
		}

		sort_render_queue()
		// The lights' directions are in this camera's eye space, so they are worked out once a camera
		if mbi.lighting.settings.enabled {
			mbi.camera_lights = calculate_lights_block(mbi.lighting, mbi.view)
			sort_lights_block_by_kind(&mbi.camera_lights)
		}
		set_depth_mode(depth_opaque)
		for item in mbi.opaque_items {
			set_cull_mode(item.cull)
			render_item(item, .NONE)
		}
		set_depth_mode(depth_transparent)
		for item in mbi.transparent_items {
			set_cull_mode(item.cull)
			render_item(item, .ALPHA)
		}
	}

	/*Fills the screen with one colour, 0..1 RGBA. Call between render_start and render_end*/
	clear_background :: proc(color:[4]f32) {
		if mbi.render_target_state.is_active || mbi.screen_scene_open {
			gfx.clear(color)
			return
		}
		mbi.pending_clear = color // the screen's scene is not open yet: ensure_screen_scene clears it
	}

	/*Fills the screen itself. Only called when no target is being drawn to*/
	@(private)
	clear_screen :: proc(color:[4]f32) {
		clear_background(color)
	}
}
