#+build freestanding arm32

package matchbox

/*
	Render -- Vita
	==============
	GXM draws the shared render queue (render.odin): camera_start sets the camera,
	render_mesh / render_sprite / the shapes record items, and camera_end sorts them with the
	shared sort and draws them here, the same scene in the same order as on PC and 3DS.

	There are three shaders, as on PC: mesh.mbs draws everything, and while lighting is on
	mesh_lit.mbs draws lit meshes per pixel (G2 L4-5) and mesh_vertex_lit.mbs per vertex (G2 L5),
	as each part's material says. Each is generated by mbsc (`-target:vita --emit-cg`) into
	<name>_v.cg and <name>_f.cg, and compiled by psp2cgc into <name>_v.gxp and <name>_f.gxp. All
	are committed, so a checkout builds without psp2cgc; the .gxp files are embedded with #load,
	as gfx does for its clear shaders.

	Inside `when VITA` for the reason in backend_vita_freestanding_arm32.odin
*/

import "core:mem"

import "vito/gfx"
import "vito/sce"

when VITA {

	/*
		Everything one shader needs to draw. Two live in Backend_State: `mbi.pipeline` and
		`mbi.lit_pipeline`. GXM ties a fragment program to its vertex program and its blend mode,
		so there is one fragment program per Blend_Mode, made up front and picked per draw
	*/
	Render_Pipeline :: struct {
		vertex_shader:gfx.Program,
		fragment_shader:gfx.Program,
		/*
			nil for the unlit shader. Otherwise it reads Lit_Vertex's normal, and the lights and the
			material: in the fragment program per pixel, in the vertex program per vertex
		*/
		lighting:Maybe(Lighting_Mode),
		vertex_program:^sce.GxmVertexProgram, // for the meshes the shader is meant for: Vertex, or Lit_Vertex when lit
		/*
			The unlit shader reading Lit_Vertex, for lit meshes while lighting is off: GXM fixes a
			stream's stride in the vertex program, and a Lit_Vertex starts with a whole Vertex.
			nil in the lit pipelines, which only ever read Lit_Vertex
		*/
		lit_vertex_program:^sce.GxmVertexProgram,
		fragment_programs:[Blend_Mode]^sce.GxmFragmentProgram,

		// Each engine uniform, found by name. mbsc names them <block>_<field>
		view_projection_uniform:^sce.GxmProgramParameter,
		model_uniform:^sce.GxmProgramParameter,
		tint_uniform:^sce.GxmProgramParameter,
		uv_rectangle_uniform:^sce.GxmProgramParameter,
		alpha_cutoff_uniform:^sce.GxmProgramParameter, // the fragment program's
		texture_unit:u32,

		// The lit pipelines' alone, nil in the unlit one. mbsc's names (tools/mbsc/lighting.odin)
		view_uniform:^sce.GxmProgramParameter, // the vertex program's: eye space
		// The rest are the fragment program's per pixel and the vertex program's per vertex
		lights_ambient_uniform:^sce.GxmProgramParameter,
		lights_direction_uniform:^sce.GxmProgramParameter,
		lights_diffuse_uniform:^sce.GxmProgramParameter,
		lights_specular_uniform:^sce.GxmProgramParameter,
		lights_position_uniform:^sce.GxmProgramParameter,
		lights_cone_uniform:^sce.GxmProgramParameter,
		lights_split_uniform:^sce.GxmProgramParameter, // per pixel only: where the suns, the bulbs and all the lights end in the sorted block (nil per vertex, whose loop runs all 8)
		shininess_uniform:^sce.GxmProgramParameter,
		specular_strength_uniform:^sce.GxmProgramParameter,

		white_texture:gfx.Texture, // bound for untextured draws: the shader always samples. mbi.pipeline's serves both
	}

	/*
		Copies vertices and indices into GPU-mapped memory, one block for both: gfx.alloc rounds
		every block up to 4 KiB, so two per mesh would waste twice as much. The slices can be
		freed afterwards
	*/
	create_mesh :: proc(vertices:[]Vertex, indices:[]u16) -> (mesh:Mesh) {
		return create_mesh_from_bytes(mem.slice_to_bytes(vertices), len(vertices), indices)
	}

	/*Copies vertices with normals and indices into GPU-mapped memory, for a model part. The slices can be freed afterwards*/
	create_lit_mesh :: proc(vertices:[]Lit_Vertex, indices:[]u16) -> (mesh:Mesh) {
		mesh = create_mesh_from_bytes(mem.slice_to_bytes(vertices), len(vertices), indices)
		mesh.lit = true
		return
	}

	/*The two kinds of mesh differ only in how many bytes a vertex has; the memory is filled the same way*/
	@(private = "file")
	create_mesh_from_bytes :: proc(vertex_bytes:[]u8, vertex_count:int, indices:[]u16) -> (mesh:Mesh) {
		assert(vertex_count > 0 && len(indices) > 0, "A mesh needs vertices and indices")
		assert(vertex_count <= 65536, "A mesh with 16-bit indices can have at most 65536 vertices")

		vertex_size := len(vertex_bytes) // a multiple of 4, so the indices after it are aligned
		index_size := len(indices) * size_of(u16)
		memory, uid := gfx.alloc(uint(vertex_size + index_size))
		ensure(memory != nil, "Out of GPU memory for a mesh")

		mesh.vertices = memory
		mesh.indices = rawptr(uintptr(memory) + uintptr(vertex_size))
		mesh.index_count = u32(len(indices))
		mesh.uid = uid
		// Uncached memory (gfx.alloc's default): no cache flush, unlike the 3DS
		mem.copy(mesh.vertices, raw_data(vertex_bytes), vertex_size)
		mem.copy(mesh.indices, raw_data(indices), index_size)
		return
	}

	/*
		Waits for the GPU first: a mesh destroyed the frame after it was drawn may still be read.
		finish waits for everything, which is slow, but destroying a mesh is rare
	*/
	destroy_mesh :: proc(mesh:Mesh) {
		if mesh.vertices == nil do return
		gfx.finish()
		gfx.free(mesh.uid)
	}

	/*What render.odin's sort groups opaque items by: texture, then mesh*/
	@(private)
	calculate_render_item_sort_key :: proc(item:Render_Item) -> [2]uintptr {
		return {uintptr(item.texture.texture), uintptr(item.mesh.vertices)}
	}

	/*
		Registers both shaders, makes their programs and finds their uniforms. Called once from
		init. Anything missing stops here with a message: a pipeline that half-loaded would draw
		nothing, with no sign why
	*/
	@(private)
	create_render_pipeline :: proc() {
		load_render_pipeline(&mbi.pipeline, #load("shaders/mesh_v.gxp"), #load("shaders/mesh_f.gxp"), nil)
		load_render_pipeline(&mbi.lit_pipeline, #load("shaders/mesh_lit_v.gxp"), #load("shaders/mesh_lit_f.gxp"), .PER_PIXEL)
		// The same vertex program: the copy differs only in having no `discard`, which the fragment stage alone holds
		load_render_pipeline(&mbi.lit_opaque_pipeline, #load("shaders/mesh_lit_v.gxp"), #load("shaders/mesh_lit_opaque_f.gxp"), .PER_PIXEL, has_alpha_test = false)
		load_render_pipeline(&mbi.vertex_lit_pipeline, #load("shaders/mesh_vertex_lit_v.gxp"), #load("shaders/mesh_vertex_lit_f.gxp"), .PER_VERTEX)

		// 8 x 8 because a linear texture's rows are padded to 8 pixels anyway
		ok:bool
		mbi.pipeline.white_texture, ok = gfx.create_texture(8, 8, .POINT, .CLAMP)
		if !ok do fail_pipeline("Could not make the white texture")
		for i in 0 ..< 64 do mbi.pipeline.white_texture.pixels[i] = 0xFFFFFFFF
	}

	/*Registers one shader's two programs, makes its vertex and fragment programs and finds its uniforms*/
	@(private = "file")
	load_render_pipeline :: proc(pipeline:^Render_Pipeline, vertex_gxp:[]u8, fragment_gxp:[]u8, lighting:Maybe(Lighting_Mode), has_alpha_test := true) {
		pipeline.lighting = lighting
		ok:bool
		pipeline.vertex_shader, ok = gfx.register_program(vertex_gxp)
		if !ok do fail_pipeline("A vertex .gxp could not be registered")
		pipeline.fragment_shader, ok = gfx.register_program(fragment_gxp)
		if !ok do fail_pipeline("A fragment .gxp could not be registered")

		// The names are the Cg main's parameters (<name>_v.cg), in Vertex's field order, with
		// Lit_Vertex's normal after them in the lit shaders
		vertex := pipeline.vertex_shader
		if lighting != nil {
			attributes := [?]sce.GxmVertexAttribute {
				gfx.attribute(vertex, "a_position", u16(offset_of(Lit_Vertex, position)), sce.GXM_ATTRIBUTE_FORMAT_F32, 3),
				gfx.attribute(vertex, "a_texcoord", u16(offset_of(Lit_Vertex, uv)), sce.GXM_ATTRIBUTE_FORMAT_F32, 2),
				gfx.attribute(vertex, "a_color", u16(offset_of(Lit_Vertex, color)), sce.GXM_ATTRIBUTE_FORMAT_F32, 4),
				gfx.attribute(vertex, "a_normal", u16(offset_of(Lit_Vertex, normal)), sce.GXM_ATTRIBUTE_FORMAT_F32, 3),
			}
			pipeline.vertex_program = gfx.create_vertex_program(vertex, attributes[:], size_of(Lit_Vertex))
			if pipeline.vertex_program == nil do fail_pipeline("The lit mesh vertex program could not be made")
		} else {
			attributes := [?]sce.GxmVertexAttribute {
				gfx.attribute(vertex, "a_position", u16(offset_of(Vertex, position)), sce.GXM_ATTRIBUTE_FORMAT_F32, 3),
				gfx.attribute(vertex, "a_texcoord", u16(offset_of(Vertex, uv)), sce.GXM_ATTRIBUTE_FORMAT_F32, 2),
				gfx.attribute(vertex, "a_color", u16(offset_of(Vertex, color)), sce.GXM_ATTRIBUTE_FORMAT_F32, 4),
			}
			pipeline.vertex_program = gfx.create_vertex_program(vertex, attributes[:], size_of(Vertex))
			if pipeline.vertex_program == nil do fail_pipeline("The mesh vertex program could not be made")
			// A lit mesh's vertices start with a whole Vertex, so the same attributes read it with the longer stride
			pipeline.lit_vertex_program = gfx.create_vertex_program(vertex, attributes[:], size_of(Lit_Vertex))
			if pipeline.lit_vertex_program == nil do fail_pipeline("The unlit program for lit meshes could not be made")
		}

		blends := [Blend_Mode]gfx.Blend {
			.NONE = .None,
			.ALPHA = .Alpha,
		}
		for blend, mode in blends {
			pipeline.fragment_programs[mode] = gfx.create_fragment_program(pipeline.fragment_shader, vertex, blend)
			if pipeline.fragment_programs[mode] == nil do fail_pipeline("A mesh fragment program could not be made")
		}

		find :: proc(program:gfx.Program, name:cstring) -> ^sce.GxmProgramParameter {
			parameter := gfx.parameter(program, name)
			if parameter == nil {
				// psp2cgc drops a uniform the shader never reads, so this is also what a
				// shader that stopped using one looks like
				print("a mesh .gxp has no uniform", name)
				panic("A uniform the engine sets is missing from a mesh shader")
			}
			return parameter
		}
		pipeline.view_projection_uniform = find(vertex, "frame_view_projection")
		pipeline.model_uniform = find(vertex, "render_model")
		pipeline.tint_uniform = find(vertex, "render_tint")
		pipeline.uv_rectangle_uniform = find(vertex, "render_uv_rectangle")
		// The shader without the test never reads the cutoff, so psp2cgc leaves it out: nil, and render_item skips it
		if has_alpha_test do pipeline.alpha_cutoff_uniform = find(pipeline.fragment_shader, "render_alpha_cutoff")
		pipeline.texture_unit = gfx.texture_unit(pipeline.fragment_shader, "tex")
		if mode, lit := lighting.?; lit {
			pipeline.view_uniform = find(vertex, "frame_view")
			// psp2cgc keeps a uniform only in the program that reads it: the fragment one per pixel, the vertex
			// one per vertex
			reads := pipeline.fragment_shader if mode == .PER_PIXEL else vertex
			pipeline.lights_ambient_uniform = find(reads, "lights_ambient")
			pipeline.lights_direction_uniform = find(reads, "lights_direction")
			pipeline.lights_diffuse_uniform = find(reads, "lights_diffuse")
			pipeline.lights_specular_uniform = find(reads, "lights_specular")
			pipeline.lights_position_uniform = find(reads, "lights_position")
			pipeline.lights_cone_uniform = find(reads, "lights_cone")
			if mode == .PER_PIXEL do pipeline.lights_split_uniform = find(reads, "lights_split")
			pipeline.shininess_uniform = find(reads, "render_shininess")
			pipeline.specular_strength_uniform = find(reads, "render_specular_strength")
		}
	}

	/*The SCE error says why, and it is lost unless printed before stopping*/
	@(private)
	fail_pipeline :: proc(message:string) -> ! {
		print(message, "error", gfx.last_program_error, "alloc error", gfx.last_alloc_error)
		panic(message)
	}

	@(private = "file")
	unload_render_pipeline :: proc(pipeline:^Render_Pipeline) {
		for program in pipeline.fragment_programs {
			if program != nil do sce.sceGxmShaderPatcherReleaseFragmentProgram(gfx.patcher, program)
		}
		if pipeline.vertex_program != nil do sce.sceGxmShaderPatcherReleaseVertexProgram(gfx.patcher, pipeline.vertex_program)
		if pipeline.lit_vertex_program != nil do sce.sceGxmShaderPatcherReleaseVertexProgram(gfx.patcher, pipeline.lit_vertex_program)
		gfx.unregister_program(&pipeline.fragment_shader)
		gfx.unregister_program(&pipeline.vertex_shader)
	}

	/*The GPU must be idle (cleanup calls gfx.finish first)*/
	@(private)
	destroy_render_pipeline :: proc() {
		gfx.destroy_texture(&mbi.pipeline.white_texture)
		unload_render_pipeline(&mbi.vertex_lit_pipeline)
		unload_render_pipeline(&mbi.lit_opaque_pipeline)
		unload_render_pipeline(&mbi.lit_pipeline)
		unload_render_pipeline(&mbi.pipeline)
		delete(mbi.opaque_items)
		delete(mbi.transparent_items)
	}

	/*
		Issues the draw call for one queued item. use_programs reserves this draw's uniform
		buffers, so every uniform is written each time, the camera's and the lights included. A
		lit mesh is drawn lit only while lighting is on, per pixel or per vertex as its material
		says, as on PC; off, it goes through the unlit shader's program for Lit_Vertex
	*/
	@(private)
	render_item :: proc(item:Render_Item, blend:Blend_Mode) {
		lit := item.mesh.lit && mbi.lighting.settings.enabled
		pipeline := &mbi.pipeline
		if lit {
			switch get_lighting_mode(item.material) {
			// A discard in a fragment program makes the GPU shade pixels it could have rejected as hidden, which the
			// big flat part of a scene pays for (measured on a Vita: 24 fps with it, 28 without); a part with no
			// cut-out takes the program without one
			case .PER_PIXEL:  pipeline = &mbi.lit_pipeline if item.alpha_cutoff > 0 else &mbi.lit_opaque_pipeline
			case .PER_VERTEX: pipeline = &mbi.vertex_lit_pipeline
			}
		}
		vertex_program := pipeline.vertex_program
		if !lit && item.mesh.lit do vertex_program = pipeline.lit_vertex_program
		vertex_uniforms, fragment_uniforms := gfx.use_programs(vertex_program, pipeline.fragment_programs[blend])

		// Odin's matrix memory goes in unchanged: mbsc wrote the Cg with mul(v, m) to match
		// (docs/shader_cg.md, "Matrices")
		model := item.model
		gfx.set_uniform_matrix(vertex_uniforms, pipeline.view_projection_uniform, &mbi.camera_view_projection)
		gfx.set_uniform_matrix(vertex_uniforms, pipeline.model_uniform, &model)
		tint := item.tint
		uv := item.uv_rectangle
		cutoff := item.alpha_cutoff
		gfx.set_uniform(vertex_uniforms, pipeline.tint_uniform, tint[:])
		gfx.set_uniform(vertex_uniforms, pipeline.uv_rectangle_uniform, uv[:])
		if pipeline.alpha_cutoff_uniform != nil do gfx.set_uniform(fragment_uniforms, pipeline.alpha_cutoff_uniform, ([^]f32)(&cutoff)[:1])
		if lit do set_light_uniforms(pipeline, vertex_uniforms, fragment_uniforms, item.material)

		// No texture is white, as on PC: the shader always samples, and white times the tint is the tint
		texture := item.texture.texture if item.texture.texture != nil else &mbi.pipeline.white_texture
		sce.sceGxmSetFragmentTexture(gfx.ctx, pipeline.texture_unit, &texture.texture)
		sce.sceGxmSetVertexStream(gfx.ctx, 0, item.mesh.vertices)
		sce.sceGxmDraw(gfx.ctx, .TRIANGLES, .U16, item.mesh.indices, item.mesh.index_count)
	}

	/*
		Writes what a lit shader reads besides the common uniforms: the camera's view for eye
		space, this camera's lights (filled at camera_end), and the part's material, into the
		program that reads them: the fragment one per pixel, the vertex one per vertex. The per-pixel
		loops run the sorted block's runs, sent as three floats; the per-vertex loop runs all 8 and
		has no counts (tools/mbsc/lighting.odin)
	*/
	@(private = "file")
	set_light_uniforms :: proc(pipeline:^Render_Pipeline, vertex_uniforms:rawptr, fragment_uniforms:rawptr, material:Material) {
		lights := &mbi.camera_lights
		gfx.set_uniform_matrix(vertex_uniforms, pipeline.view_uniform, &mbi.view)
		buffer := fragment_uniforms if pipeline.lighting == .PER_PIXEL else vertex_uniforms
		gfx.set_uniform(buffer, pipeline.lights_ambient_uniform, lights.ambient[:])
		gfx.set_uniform(buffer, pipeline.lights_direction_uniform, ([^]f32)(&lights.direction)[:4 * LIGHT_SLOT_COUNT])
		gfx.set_uniform(buffer, pipeline.lights_diffuse_uniform, ([^]f32)(&lights.diffuse)[:4 * LIGHT_SLOT_COUNT])
		gfx.set_uniform(buffer, pipeline.lights_specular_uniform, ([^]f32)(&lights.specular)[:4 * LIGHT_SLOT_COUNT])
		gfx.set_uniform(buffer, pipeline.lights_position_uniform, ([^]f32)(&lights.position)[:4 * LIGHT_SLOT_COUNT])
		gfx.set_uniform(buffer, pipeline.lights_cone_uniform, ([^]f32)(&lights.cone)[:4 * LIGHT_SLOT_COUNT])
		if pipeline.lights_split_uniform != nil {
			split := [3]f32{f32(lights.sun_count), f32(lights.sun_count + lights.point_count), f32(lights.count)}
			gfx.set_uniform(buffer, pipeline.lights_split_uniform, split[:])
		}
		shininess := material.shininess
		strength := material.specular_strength
		gfx.set_uniform(buffer, pipeline.shininess_uniform, ([^]f32)(&shininess)[:1])
		gfx.set_uniform(buffer, pipeline.specular_strength_uniform, ([^]f32)(&strength)[:1])
	}

	/*
		Sets the depth test for one draw. LESS as on PC: gfx.set_viewport puts near at 0 and the
		surface starts every scene at 1, so smaller is nearer. The 3DS is the one that is reversed
	*/
	@(private)
	set_depth_mode :: proc(depth:Depth_Mode) {
		switch depth {
		case .OPAQUE:
			sce.sceGxmSetFrontDepthFunc(gfx.ctx, .LESS)
			sce.sceGxmSetFrontDepthWriteEnable(gfx.ctx, .ENABLED)
		case .TRANSPARENT:
			sce.sceGxmSetFrontDepthFunc(gfx.ctx, .LESS)
			sce.sceGxmSetFrontDepthWriteEnable(gfx.ctx, .DISABLED)
		case .DISABLED:
			sce.sceGxmSetFrontDepthFunc(gfx.ctx, .ALWAYS)
			sce.sceGxmSetFrontDepthWriteEnable(gfx.ctx, .DISABLED)
		}
	}

	/*
		Skips triangles facing away for .BACK. PC and the 3DS treat counter-clockwise as front, so
		clockwise is what gets culled. gfx.set_viewport flips y, which made it unclear whether GXM
		judges winding before or after the flip: the V4 test answered it (a clockwise triangle is
		culled with .CW, a counter-clockwise one draws), checked in Vita3K, not yet on hardware
	*/
	@(private)
	set_cull_mode :: proc(cull:Cull_Mode) {
		switch cull {
		case .BACK: sce.sceGxmSetCullMode(gfx.ctx, .CW)
		case .NONE: sce.sceGxmSetCullMode(gfx.ctx, .NONE)
		}
	}

	render_start :: proc() {
		gfx.begin_frame()
	}

	/*Renders final output -- ends the scene and queues it for display, which waits for vsync*/
	render_end :: proc() {
		gfx.end_frame()
		gfx.swap()
	}

	/*
		Everything drawn until camera_end is seen through this camera. Records the same state
		the PC's does, so the shared queue (render.odin) fills exactly as it does there
	*/
	camera_start :: proc(camera:Camera) {
		ensure(mbi.camera_active == false, "camera_start called again before camera_end")

		window := [2]f32{f32(mbi.window_size[0]), f32(mbi.window_size[1])}
		used := calculate_camera_snapped(camera, window)
		mbi.pixel_scale = calculate_camera_snap_scale(camera, window.y)

		mbi.view = calculate_camera_view_matrix(used)
		mbi.camera_active = true
		mbi.screen_pass = camera.screen
		// While the bottom screen fills the screen, the world and HUD are not shown. As on PC
		mbi.discard_pass = is_top_screen_hidden()

		// gfx.set_viewport maps clip z -1..1 onto depth 0..1, so linalg's GL projection goes in
		// as it is: no remap, unlike D3D and the PICA
		mbi.camera_view_projection = calculate_camera_projection_gl(used, window.x / window.y) * mbi.view
	}

	/*Sorts and draws everything queued since camera_start*/
	camera_end :: proc() {
		ensure(mbi.camera_active == true, "camera_end called without camera_start")
		defer {
			clear(&mbi.opaque_items)
			clear(&mbi.transparent_items)
			mbi.camera_active = false
			mbi.screen_pass = false
			mbi.discard_pass = false
		}

		// A hidden pass was queued but is never drawn
		if mbi.discard_pass == true do return

		// A screen camera has no depth buffer to lean on, so what is drawn last lands on top
		depth_opaque := Depth_Mode.OPAQUE
		depth_transparent := Depth_Mode.TRANSPARENT
		if mbi.screen_pass == true {
			depth_opaque = .DISABLED
			depth_transparent = .DISABLED
		}

		sort_render_queue()
		// The lights' directions are in this camera's eye space, so they are worked out once a camera
		if mbi.lighting.settings.enabled {
			mbi.camera_lights = calculate_lights_block(mbi.lighting, mbi.view)
			sort_lights_block_by_kind(&mbi.camera_lights)
		}
		set_depth_mode(depth_opaque)
		for item in mbi.opaque_items {
			set_cull_mode(item.cull)
			render_item(item, .NONE)
		}
		set_depth_mode(depth_transparent)
		for item in mbi.transparent_items {
			set_cull_mode(item.cull)
			render_item(item, .ALPHA)
		}
	}

	/*Fills the screen with one colour, 0..1 RGBA. Call between render_start and render_end*/
	clear_background :: proc(color:[4]f32) {
		gfx.clear(color)
	}
}
