Vertex :: struct
{
    pos: vec3,
    color: vec3
}

Data :: struct
{
    verts: []Vertex,
    shape: int,
}

FragData :: struct {
    color:vec4,
    pos:vec3,
}

Vert_Output :: struct
{
    pos: vec4 @position,
    color: vec4 @io(0),
   	frag_pos:vec2 @io(1),
}

vert :: #vertex (vert_id: uint @vert_id, data: ^Data @data) -> Vert_Output
{
    out: Vert_Output;
    out.pos = vec4(data.verts[vert_id].pos, 1.0);
    out.color = vec4(data.verts[vert_id].color, 1.0);
	out.frag_pos = data.verts[vert_id].pos.xy;
    return out;
}

frag :: #fragment (input: Vert_Output, frag_data:^FragData @data) -> vec4 @io(0) {

   	p:vec2 = input.frag_pos;

	final_color:vec4 = frag_data.color;

   	resolution:vec2 = vec2(1920.0, 1080.0);
   	aspect:float = resolution.x / resolution.y;

   	p_corrected:vec2 = vec2(p.x * aspect, p.y);

   	center:vec2 = vec2(0.0, 0.0);

   	circle_radius := length(p_corrected - center) * 3;

   	if circle_radius < 1 {
  		final_color = frag_data.color;
   	} else {
  		final_color = vec4(0.0, 0.0, 0.0, 1.0);
   	}

    return final_color;
}
