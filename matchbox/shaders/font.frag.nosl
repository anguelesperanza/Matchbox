Data :: struct {
    texture_a: texture_id,
    s:         sampler_id,
    color:     vec4,
}

main :: (uv: vec2 @input(0), data: ^Data @data) -> vec4 @output(0)
{
    sampled:vec4 = texture_sample(data.texture_a, data.s, uv);
    result:vec4  = vec4(data.color.r, data.color.g, data.color.b, data.color.a * sampled.a);
    return result;
}
