// Generated by mbsc. Edit the .mbs shader and generate this file again; changes made here are lost.

struct Vertex_In {
    float3 position : position;
    float2 uv : texcoord;
    float4 color : color;
    float3 normal : normal;
};

struct Varying {
    float4 position : SV_POSITION;
    float2 uv : TEXCOORD0;
    float4 color : COLOR;
    float4 quat : NORMALQUAT;
    float3 view : VIEW;
};

cbuffer frame_block : register(b0) {
    float4x4 frame_view_projection;
    float frame_time;
    float4x4 frame_view;
};

cbuffer render_block : register(b1) {
    float4x4 render_model;
    float4 render_tint;
    float4 render_uv_rectangle;
    float render_alpha_cutoff;
    float render_shininess;
    float render_specular_strength;
};

Texture2D tex : register(t0);
SamplerState mbs_sampler : register(s0);

cbuffer mbs_lights_block : register(b3) {
    float4 lights_ambient;
    float4 lights_direction[64];
    float4 lights_diffuse[64];
    float4 lights_specular[64];
    float4 lights_position[64];
    float4 lights_cone[64];
    int lights_count;
};

// The light built-ins, following the 3DS's fragment lighting unit (mbsc's lighting.odin says how).
float3 mbs_light_normal(float4 q) {
    float4 u = normalize(q);
    return float3(2.0 * (u.x * u.z + u.w * u.y), 2.0 * (u.y * u.z - u.w * u.x), 1.0 - 2.0 * (u.x * u.x + u.y * u.y));
}

float3 mbs_light_unit(float3 d) {
    return d * rsqrt(max(dot(d, d), 1e-12));
}

float mbs_light_sample(int i, float3 position, out float3 l) {
    float kind = lights_position[i].w;
    float fade = 1.0;
    float3 axis = mbs_light_unit(lights_direction[i].xyz);
    l = axis;
    if (kind > 0.5) {
        float3 to = lights_position[i].xyz - position;
        float d = sqrt(dot(to, to));
        l = mbs_light_unit(to);
        fade = 1.0 / (1.0 + 0.09 * d + 0.032 * d * d);
        if (kind > 1.5) {
            float t = saturate(dot(l, axis) * lights_cone[i].z + lights_cone[i].w);
            fade *= t * t * (3.0 - 2.0 * t);
        }
    }
    return fade;
}

float4 mbs_light_diffuse(float4 q, float3 view) {
    float3 n = mbs_light_normal(q);
    float3 sum = lights_ambient.rgb;
    for (int i = 0; i < lights_count; i++) {
        float3 l;
        float fade = mbs_light_sample(i, -view, l);
        sum += lights_diffuse[i].rgb * (max(dot(l, n), 0.0) * fade);
    }
    return float4(saturate(sum), 1.0);
}

float4 mbs_light_specular(float4 q, float3 view) {
    float3 n = mbs_light_normal(q);
    float3 v = mbs_light_unit(view);
    float3 sum = float3(0.0, 0.0, 0.0);
    for (int i = 0; i < lights_count; i++) {
        float3 l;
        float fade = mbs_light_sample(i, -view, l);
        float3 h = mbs_light_unit(l + v);
        float facing = dot(l, n) > 0.0 ? 1.0 : 0.0;
        sum += lights_specular[i].rgb * (facing * fade * pow(max(dot(n, h), 1e-8), render_shininess));
    }
    return float4(saturate(sum * render_specular_strength), 0.0);
}

float4 mbs_normal_quaternion(float3 n) {
    return normalize(float4(-n.y, n.x, 0.0, max(1.0 + n.z, 0.00001)));
}

Varying vertex_main(Vertex_In input) {
    Varying output = (Varying)0;
    float4 world = mul(render_model, float4(input.position.x, input.position.y, input.position.z, 1.0));
    output.position = mul(frame_view_projection, world);
    output.color = input.color * render_tint;
    output.uv = lerp(render_uv_rectangle.xy, render_uv_rectangle.zw, input.uv);
    float4 eye = mul(frame_view, world);
    output.view = float3((-eye.x), (-eye.y), (-eye.z));
    float4 turned = mul(frame_view, mul(render_model, float4(input.normal.x, input.normal.y, input.normal.z, 0.0)));
    output.quat = mbs_normal_quaternion(normalize(turned.xyz));
    return output;
}

float4 fragment_main(Varying v) : SV_TARGET {
    float4 surface = tex.Sample(mbs_sampler, v.uv) * v.color;
    float4 color = (mbs_light_diffuse(v.quat, v.view) * surface) + mbs_light_specular(v.quat, v.view);
    if (color.w < render_alpha_cutoff) {
        discard;
    }
    return color;
}
