// Generated by mbsc. Edit the .mbs shader and generate this file again; changes made here are lost.

struct Vertex_In {
    float3 position;
    float2 uv;
    float4 color;
    float3 normal;
};

struct Varying {
    float4 position;
    float2 uv;
    float4 color;
    float4 quat;
    float3 view;
};

// frame
uniform float4x4 frame_view_projection;
uniform float frame_time;
uniform float4x4 frame_view;

// render
uniform float4x4 render_model;
uniform float4 render_tint;
uniform float4 render_uv_rectangle;
uniform float render_alpha_cutoff;
uniform float render_shininess;
uniform float render_specular_strength;

uniform sampler2D tex : TEXUNIT0;

// the engine's lights
uniform float4 lights_ambient;
uniform float4 lights_direction[8];
uniform float4 lights_diffuse[8];
uniform float4 lights_specular[8];
uniform float4 lights_position[8];
uniform float4 lights_cone[8];

// The light built-ins, following the 3DS's fragment lighting unit (mbsc's lighting.odin says how).
float3 mbs_light_normal(float4 q) {
    float4 u = normalize(q);
    return float3(2.0 * (u.x * u.z + u.w * u.y), 2.0 * (u.y * u.z - u.w * u.x), 1.0 - 2.0 * (u.x * u.x + u.y * u.y));
}

float3 mbs_light_unit(float3 d) {
    return d * rsqrt(max(dot(d, d), 1e-12));
}

float mbs_light_sample(int i, float3 position, out float3 l) {
    float kind = lights_position[i].w;
    float fade = 1.0;
    float3 axis = mbs_light_unit(lights_direction[i].xyz);
    l = axis;
    if (kind > 0.5) {
        float3 to = lights_position[i].xyz - position;
        float d = sqrt(dot(to, to));
        l = mbs_light_unit(to);
        fade = 1.0 / (1.0 + 0.09 * d + 0.032 * d * d);
        if (kind > 1.5) {
            float t = saturate(dot(l, axis) * lights_cone[i].z + lights_cone[i].w);
            fade *= t * t * (3.0 - 2.0 * t);
        }
    }
    return fade;
}

float4 mbs_light_diffuse(float4 q, float3 view) {
    float3 n = mbs_light_normal(q);
    float3 sum = lights_ambient.rgb;
    for (int i = 0; i < 8; i++) {
        float3 l;
        float fade = mbs_light_sample(i, -view, l);
        sum += lights_diffuse[i].rgb * (max(dot(l, n), 0.0) * fade);
    }
    return float4(saturate(sum), 1.0);
}

float4 mbs_light_specular(float4 q, float3 view) {
    float3 n = mbs_light_normal(q);
    float3 v = mbs_light_unit(view);
    float3 sum = float3(0.0, 0.0, 0.0);
    for (int i = 0; i < 8; i++) {
        float3 l;
        float fade = mbs_light_sample(i, -view, l);
        float3 h = mbs_light_unit(l + v);
        float facing = dot(l, n) > 0.0 ? 1.0 : 0.0;
        sum += lights_specular[i].rgb * (facing * fade * pow(max(dot(n, h), 1e-8), render_shininess));
    }
    return float4(saturate(sum * render_specular_strength), 0.0);
}

float4 mbs_normal_quaternion(float3 n) {
    return normalize(float4(-n.y, n.x, 0.0, max(1.0 + n.z, 0.00001)));
}

float4 fragment_main(Varying v) {
    float4 surface = tex2D(tex, v.uv) * v.color;
    float4 color = (mbs_light_diffuse(v.quat, v.view) * surface) + mbs_light_specular(v.quat, v.view);
    if (color.w < render_alpha_cutoff) {
        discard;
    }
    return color;
}

float4 main(float4 i_position : WPOS,
            float2 i_uv : TEXCOORD0,
            float4 i_color : COLOR0,
            float4 i_quat : TEXCOORD3,
            float3 i_view : TEXCOORD4) : COLOR {
    Varying v = (Varying)0;
    v.position = i_position;
    v.uv = i_uv;
    v.color = i_color;
    v.quat = i_quat;
    v.view = i_view;
    return fragment_main(v);
}
