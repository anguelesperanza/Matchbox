// Generated by mbsc. Edit the .mbs shader and generate this file again; changes made here are lost.

struct Vertex_In {
    float3 position;
    float2 uv;
    float4 color;
    float3 normal;
};

struct Varying {
    float4 position;
    float2 uv;
    float4 color;
    float4 quat;
    float3 view;
};

// frame
uniform float4x4 frame_view_projection;
uniform float frame_time;
uniform float4x4 frame_view;

// render
uniform float4x4 render_model;
uniform float4 render_tint;
uniform float4 render_uv_rectangle;
uniform float render_alpha_cutoff;
uniform float render_shininess;
uniform float render_specular_strength;

uniform sampler2D tex : TEXUNIT0;

// the engine's lights
uniform float4 lights_ambient;
uniform float4 lights_direction[8];
uniform float4 lights_diffuse[8];
uniform float4 lights_specular[8];
uniform float4 lights_position[8];
uniform float4 lights_cone[8];
uniform float3 lights_split;

// The light built-ins, following the 3DS's fragment lighting unit (mbsc's lighting.odin says how).
float3 mbs_light_normal(float4 q) {
    float4 u = normalize(q);
    return float3(2.0 * (u.x * u.z + u.w * u.y), 2.0 * (u.y * u.z - u.w * u.x), 1.0 - 2.0 * (u.x * u.x + u.y * u.y));
}

float3 mbs_light_unit(float3 d) {
    return d * rsqrt(max(dot(d, d), 1e-12));
}

static float3 mbs_light_diffuse_sum;
static float3 mbs_light_specular_sum;
static float mbs_light_done = 0.0;

// One light's share, given the way to it and how much of it arrives.
void mbs_light_add(int i, float3 l, float fade, float3 n, float3 v) {
    float facing = dot(l, n);
    mbs_light_diffuse_sum += lights_diffuse[i].rgb * (max(facing, 0.0) * fade);
    if (render_specular_strength > 0.0) {
        float3 hu = l + v;
        float nh = dot(n, hu) * rsqrt(max(dot(hu, hu), 1e-12));
        mbs_light_specular_sum += lights_specular[i].rgb * ((facing > 0.0 ? 1.0 : 0.0) * fade * pow(max(nh, 1e-8), render_shininess));
    }
}

// The distance fade of a bulb at distance d: 1 / (1 + 0.09 d + 0.032 d d).
float mbs_light_fade(float d) {
    return 1.0 / (1.0 + d * (0.09 + 0.032 * d));
}

void mbs_light_all(float4 q, float3 view) {
    if (mbs_light_done == 0.0) {
        float3 n = mbs_light_normal(q);
        float3 v = mbs_light_unit(view);
        float3 position = -view;
        mbs_light_diffuse_sum = lights_ambient.rgb;
        mbs_light_specular_sum = float3(0.0, 0.0, 0.0);
        int suns = (int)(lights_split.x);
        int points = (int)(lights_split.y);
        int total = (int)(lights_split.z);
        for (int i = 0; i < suns; i++) {
            mbs_light_add(i, lights_direction[i].xyz, 1.0, n, v);
        }
        for (int i = suns; i < points; i++) {
            float3 to = lights_position[i].xyz - position;
            float squared = max(dot(to, to), 1e-12);
            float inverse = rsqrt(squared);
            mbs_light_add(i, to * inverse, mbs_light_fade(squared * inverse), n, v);
        }
        for (int i = points; i < total; i++) {
            float3 to = lights_position[i].xyz - position;
            float squared = max(dot(to, to), 1e-12);
            float inverse = rsqrt(squared);
            float3 l = to * inverse;
            // smoothstep(cos outer, cos inner, cos angle), written out: Cg's is undefined for equal edges
            float t = saturate(dot(l, lights_direction[i].xyz) * lights_cone[i].z + lights_cone[i].w);
            mbs_light_add(i, l, mbs_light_fade(squared * inverse) * (t * t * (3.0 - 2.0 * t)), n, v);
        }
        mbs_light_diffuse_sum = saturate(mbs_light_diffuse_sum);
        mbs_light_specular_sum = saturate(mbs_light_specular_sum * render_specular_strength);
        mbs_light_done = 1.0;
    }
}

float4 mbs_light_diffuse(float4 q, float3 view) {
    mbs_light_all(q, view);
    return float4(mbs_light_diffuse_sum, 1.0);
}

float4 mbs_light_specular(float4 q, float3 view) {
    mbs_light_all(q, view);
    return float4(mbs_light_specular_sum, 0.0);
}

float4 mbs_normal_quaternion(float3 n) {
    return normalize(float4(-n.y, n.x, 0.0, max(1.0 + n.z, 0.00001)));
}

float4 fragment_main(Varying v) {
    float4 surface = tex2D(tex, v.uv) * v.color;
    float4 color = (mbs_light_diffuse(v.quat, v.view) * surface) + mbs_light_specular(v.quat, v.view);
    return color;
}

float4 main(float4 i_position : WPOS,
            float2 i_uv : TEXCOORD0,
            float4 i_color : COLOR0,
            float4 i_quat : TEXCOORD3,
            float3 i_view : TEXCOORD4) : COLOR {
    Varying v = (Varying)0;
    v.position = i_position;
    v.uv = i_uv;
    v.color = i_color;
    v.quat = i_quat;
    v.view = i_view;
    return fragment_main(v);
}
