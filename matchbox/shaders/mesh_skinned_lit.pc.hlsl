// Generated by mbsc. Edit the .mbs shader and generate this file again; changes made here are lost.

struct Vertex_In {
    float3 position : position;
    float2 uv : texcoord;
    float4 color : color;
    float3 normal : normal;
    float4 joints : joints;
    float4 weights : weights;
};

struct Varying {
    float4 position : SV_POSITION;
    float2 uv : TEXCOORD0;
    float4 color : COLOR;
    float4 quat : NORMALQUAT;
    float3 view : VIEW;
};

cbuffer frame_block : register(b0) {
    float4x4 frame_view_projection;
    float frame_time;
    float4x4 frame_view;
};

cbuffer skin_block : register(b4) {
    float4 skin_row0[256];
    float4 skin_row1[256];
    float4 skin_row2[256];
};

cbuffer render_block : register(b1) {
    float4x4 render_model;
    float4 render_tint;
    float4 render_uv_rectangle;
    float render_alpha_cutoff;
    float render_shininess;
    float render_specular_strength;
};

Texture2D tex : register(t0);
SamplerState mbs_sampler : register(s0);

cbuffer mbs_lights_block : register(b3) {
    float4 lights_ambient;
    float4 lights_direction[64];
    float4 lights_diffuse[64];
    float4 lights_specular[64];
    float4 lights_position[64];
    float4 lights_cone[64];
    int lights_count;
    float4 lights_ground;
    float4 lights_up;
    float4 lights_fog_color;
    float4 lights_fog_range;
    float4 lights_shadow_x;
    float4 lights_shadow_y;
    float4 lights_shadow_z;
    float4 lights_shadow_w;
    float4 lights_shadow_params;
};

// The light built-ins, following the 3DS's fragment lighting unit (mbsc's lighting.odin says how).
float3 mbs_light_normal(float4 q) {
    float4 u = normalize(q);
    return float3(2.0 * (u.x * u.z + u.w * u.y), 2.0 * (u.y * u.z - u.w * u.x), 1.0 - 2.0 * (u.x * u.x + u.y * u.y));
}

float3 mbs_light_unit(float3 d) {
    return d * rsqrt(max(dot(d, d), 1e-12));
}

// Light sums are clamped to 1 unless a tonemap is on: then they are left bright for the curve to bring down
float3 mbs_light_limit(float3 sum) {
    return lights_fog_range.w > 0.5 ? max(sum, 0.0) : saturate(sum);
}

float3 mbs_agx_contrast(float3 x) {
    float3 x2 = x * x;
    float3 x4 = x2 * x2;
    return 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232;
}

float3 mbs_agx(float3 v) {
    const float3x3 input_matrix = float3x3(0.842479062253094, 0.0423282422610123, 0.0423756549057051, 0.0784335999999992, 0.878468636469772, 0.0784336, 0.0792237451477643, 0.0791661274605434, 0.879142973793104);
    const float3x3 output_matrix = float3x3(1.19687900512017, -0.0528968517574562, -0.0529716355144438, -0.0980208811401368, 1.15190312990417, -0.0980434501171241, -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
    v = mul(v, input_matrix);
    v = clamp(log2(max(v, 1e-10)), -12.47393, 4.026069);
    v = (v + 12.47393) / (4.026069 + 12.47393);
    v = mbs_agx_contrast(v);
    v = mul(v, output_matrix);
    return pow(max(v, 0.0), 2.2); // the framebuffer is sRGB, so the picture is handed over as linear light
}

float3 mbs_tonemap(float3 c, float kind) {
    if (kind > 2.5) return saturate(mbs_agx(c));
    if (kind > 1.5) return saturate((c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14));
    if (kind > 0.5) return c / (1.0 + c);
    return saturate(c);
}

// Exposure, then the curve, then fog, so the fog colour reaches the screen as it was chosen
float4 mbs_light_finish(float4 color, float3 view) {
    float3 rgb = color.rgb * lights_fog_range.z;
    rgb = mbs_tonemap(rgb, lights_fog_range.w);
    float fog = saturate((length(view) - lights_fog_range.x) * lights_fog_range.y) * lights_fog_color.w;
    return float4(lerp(rgb, lights_fog_color.rgb, fog), color.a);
}

Texture2D<float> mbs_shadow_map : register(t7);
SamplerComparisonState mbs_shadow_sampler : register(s7);

float mbs_light_shadow(int i, float3 position, float3 n) {
    if (abs(lights_shadow_params.x - (float)i) > 0.5) return 1.0;
    float4 p = float4(position + n * lights_shadow_params.w, 1.0);
    float4 clip = float4(dot(lights_shadow_x, p), dot(lights_shadow_y, p), dot(lights_shadow_z, p), dot(lights_shadow_w, p));
    if (clip.w <= 1e-6) return 1.0;
    float3 ndc = clip.xyz / clip.w;
    float2 uv = float2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 || ndc.z > 1.0 || ndc.z < 0.0) return 1.0;
    float lit = 0.0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            lit += mbs_shadow_map.SampleCmpLevelZero(mbs_shadow_sampler, uv + float2(dx, dy) * lights_shadow_params.y, ndc.z - lights_shadow_params.z);
        }
    }
    return lit / 9.0;
}

float mbs_light_sample(int i, float3 position, out float3 l) {
    float kind = lights_position[i].w;
    if (kind > 2.5) {
        float3 normal = lights_direction[i].xyz;
        float3 right = lights_cone[i].xyz;
        float3 up = cross(normal, right);
        float3 away = position - lights_position[i].xyz;
        float2 local = float2(dot(away, right), dot(away, up));
        float2 extent = float2(lights_cone[i].w, lights_direction[i].w);
        float reach = length(local);
        float2 nearest = kind > 3.5 ? local * min(1.0, extent.x / max(reach, 1e-12)) : clamp(local, -extent, extent);
        float3 to = lights_position[i].xyz + right * nearest.x + up * nearest.y - position;
        float squared = max(dot(to, to), 1e-12);
        float inverse = rsqrt(squared);
        float d = squared * inverse;
        l = to * inverse;
        return (dot(away, normal) > 0.0 ? 1.0 : 0.0) / (1.0 + d * (0.09 + 0.032 * d));
    }
    float is_point = step(0.5, kind);
    float is_spot = step(1.5, kind);
    float3 axis = lights_direction[i].xyz;
    float3 to = lights_position[i].xyz - position;
    float squared = max(dot(to, to), 1e-12);
    float inverse = rsqrt(squared);
    float d = squared * inverse;
    l = lerp(axis, to * inverse, is_point);
    float fade = lerp(1.0, 1.0 / (1.0 + d * (0.09 + 0.032 * d)), is_point);
    float t = saturate(dot(l, axis) * lights_cone[i].z + lights_cone[i].w);
    return fade * lerp(1.0, t * t * (3.0 - 2.0 * t), is_spot);
}

float4 mbs_light_diffuse(float4 q, float3 view) {
    float3 n = mbs_light_normal(q);
    float3 sum = lerp(lights_ambient.rgb, lerp(lights_ground.rgb, lights_ambient.rgb, dot(n, lights_up.xyz) * 0.5 + 0.5), lights_up.w);
    int total = (int)(lights_count);
    for (int i = 0; i < total; i++) {
        float3 l;
        float fade = mbs_light_sample(i, -view, l) * mbs_light_shadow(i, -view, n);
        sum += lights_diffuse[i].rgb * (max(dot(l, n), 0.0) * fade);
    }
    return float4(mbs_light_limit(sum), 1.0);
}

float4 mbs_light_specular(float4 q, float3 view) {
    float3 n = mbs_light_normal(q);
    float3 v = mbs_light_unit(view);
    float3 sum = float3(0.0, 0.0, 0.0);
    int total = (int)(lights_count);
    for (int i = 0; i < total; i++) {
        float3 l;
        float fade = mbs_light_sample(i, -view, l) * mbs_light_shadow(i, -view, n);
        float3 h = mbs_light_unit(l + v);
        float facing = dot(l, n) > 0.0 ? 1.0 : 0.0;
        sum += lights_specular[i].rgb * (facing * fade * pow(max(dot(n, h), 1e-8), render_shininess));
    }
    return float4(mbs_light_limit(sum * render_specular_strength), 0.0);
}

float4 mbs_normal_quaternion(float3 n) {
    return normalize(float4(-n.y, n.x, 0.0, max(1.0 + n.z, 0.00001)));
}

Varying vertex_main(Vertex_In input) {
    Varying output = (Varying)0;
    float4 joints = input.joints;
    float4 weights = input.weights;
    {
        joints = (input.joints * 255.0) + 0.5;
    }
    float4 row0 = float4(0.0, 0.0, 0.0, 0.0);
    float4 row1 = float4(0.0, 0.0, 0.0, 0.0);
    float4 row2 = float4(0.0, 0.0, 0.0, 0.0);
    for (int k = 0; k < 4; k++) {
        float weight = weights[k];
        row0 = row0 + (skin_row0[((int)(joints[k]))] * weight);
        row1 = row1 + (skin_row1[((int)(joints[k]))] * weight);
        row2 = row2 + (skin_row2[((int)(joints[k]))] * weight);
    }
    float4 at = float4(input.position.x, input.position.y, input.position.z, 1.0);
    float4 along = float4(input.normal.x, input.normal.y, input.normal.z, 0.0);
    float4 moved = float4(dot(row0, at), dot(row1, at), dot(row2, at), 1.0);
    float4 leaned = float4(dot(row0, along), dot(row1, along), dot(row2, along), 0.0);
    float4 world = mul(render_model, moved);
    output.position = mul(frame_view_projection, world);
    output.color = input.color * render_tint;
    output.uv = lerp(render_uv_rectangle.xy, render_uv_rectangle.zw, input.uv);
    float4 eye = mul(frame_view, world);
    output.view = float3((-eye.x), (-eye.y), (-eye.z));
    float4 turned = mul(frame_view, mul(render_model, leaned));
    output.quat = mbs_normal_quaternion(normalize(turned.xyz));
    return output;
}

float4 fragment_main(Varying v) : SV_TARGET {
    float4 surface = tex.Sample(mbs_sampler, v.uv) * v.color;
    float4 color = (mbs_light_diffuse(v.quat, v.view) * surface) + mbs_light_specular(v.quat, v.view);
    {
        color = mbs_light_finish(color, v.view);
    }
    if (color.w < render_alpha_cutoff) {
        discard;
    }
    return color;
}
