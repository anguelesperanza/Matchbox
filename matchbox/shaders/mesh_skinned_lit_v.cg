// Generated by mbsc. Edit the .mbs shader and generate this file again; changes made here are lost.

struct Vertex_In {
    float3 position;
    float2 uv;
    float4 color;
    float3 normal;
    float4 joints;
    float4 weights;
};

struct Varying {
    float4 position;
    float2 uv;
    float4 color;
    float4 quat;
    float3 view;
};

// frame
uniform float4x4 frame_view_projection;
uniform float frame_time;
uniform float4x4 frame_view;

// skin
uniform float4 skin_row0[64];
uniform float4 skin_row1[64];
uniform float4 skin_row2[64];

// render
uniform float4x4 render_model;
uniform float4 render_tint;
uniform float4 render_uv_rectangle;
uniform float render_alpha_cutoff;
uniform float render_shininess;
uniform float render_specular_strength;

uniform sampler2D tex : TEXUNIT0;

float4 mbs_normal_quaternion(float3 n) {
    return normalize(float4(-n.y, n.x, 0.0, max(1.0 + n.z, 0.00001)));
}

Varying vertex_main(Vertex_In input) {
    Varying output = (Varying)0;
    float4 joints = input.joints;
    float4 weights = input.weights;
    float4 row0 = float4(0.0, 0.0, 0.0, 0.0);
    float4 row1 = float4(0.0, 0.0, 0.0, 0.0);
    float4 row2 = float4(0.0, 0.0, 0.0, 0.0);
    for (int k = 0; k < 4; k++) {
        float weight = weights[k];
        row0 = row0 + (skin_row0[((int)(joints[k]))] * weight);
        row1 = row1 + (skin_row1[((int)(joints[k]))] * weight);
        row2 = row2 + (skin_row2[((int)(joints[k]))] * weight);
    }
    float4 at = float4(input.position.x, input.position.y, input.position.z, 1.0);
    float4 along = float4(input.normal.x, input.normal.y, input.normal.z, 0.0);
    float4 moved = float4(dot(row0, at), dot(row1, at), dot(row2, at), 1.0);
    float4 leaned = float4(dot(row0, along), dot(row1, along), dot(row2, along), 0.0);
    float4 world = mul(moved, render_model);
    output.position = mul(world, frame_view_projection);
    output.color = input.color * render_tint;
    output.uv = lerp(render_uv_rectangle.xy, render_uv_rectangle.zw, input.uv);
    float4 eye = mul(world, frame_view);
    output.view = float3((-eye.x), (-eye.y), (-eye.z));
    float4 turned = mul(mul(leaned, render_model), frame_view);
    output.quat = mbs_normal_quaternion(normalize(turned.xyz));
    return output;
}

void main(float3 a_position, float2 a_texcoord, float4 a_color, float3 a_normal, float4 a_joints, float4 a_weights,
          out float4 o_position : POSITION,
          out float2 o_uv : TEXCOORD0,
          out float4 o_color : COLOR0,
          out float4 o_quat : TEXCOORD3,
          out float3 o_view : TEXCOORD4) {
    Vertex_In input = (Vertex_In)0;
    input.position = a_position;
    input.uv = a_texcoord;
    input.color = a_color;
    input.normal = a_normal;
    input.joints = a_joints;
    input.weights = a_weights;
    Varying result = vertex_main(input);
    o_position = result.position;
    o_uv = result.uv;
    o_color = result.color;
    o_quat = result.quat;
    o_view = result.view;
}
