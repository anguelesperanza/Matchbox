// HAND-WRITTEN, PC only. Unlike every other .pc.hlsl in this folder this is not generated by mbsc, and there is no
// skybox.mbs: the shader language has no cube texture type yet (docs/shader_capabilities.md lists it as `?` on the
// other targets), so the one shader that needs TextureCube is written in HLSL directly. skybox_windows.odin compiles it
// at start up, as it does the generated ones, and binds it by fixed registers instead of a reflection file.
//
// The vertex stage reads no geometry: three vertices from SV_VertexID make one oversized triangle that covers the
// screen. It hands the pixel stage a direction, the camera's basis already scaled by the field of view, so the ray
// through a pixel is the sum of the three: the projection undone without inverting anything.

cbuffer skybox_block : register(b0) {
    float4 ray_right;   // the camera's right, scaled by tan(fov / 2) * aspect
    float4 ray_up;      // the camera's up, scaled by tan(fov / 2)
    float4 ray_forward; // the camera's forward, unit length
    float4 tint;        // multiplies what the sky shows
};

struct Varying {
    float4 position : SV_POSITION;
    float3 direction : TEXCOORD0;
};

Varying vertex_main(uint id : SV_VertexID) {
    // (0,0), (2,0), (0,2) -> clip (-1,-1), (3,-1), (-1,3); the part off screen is clipped and costs nothing
    float2 corner = float2((id << 1) & 2, id & 2);
    float2 ndc = float2(corner.x * 2.0 - 1.0, 1.0 - corner.y * 2.0);

    Varying output = (Varying)0;
    // Depth is not tested or written for the sky (it is drawn first), so z only has to be inside the clip volume
    output.position = float4(ndc, 0.0, 1.0);
    // Not normalised: three unit vectors interpolated across a triangle are not unit in the middle, so the pixel stage
    // has to normalise anyway
    output.direction = ray_forward.xyz + ray_right.xyz * ndc.x + ray_up.xyz * ndc.y;
    return output;
}

TextureCube<float4> cube_sky : register(t0);
Texture2D<float4> panorama_sky : register(t0);
SamplerState sky_sampler : register(s0); // linear; wraps across u (the panorama's seam), clamps down v

float4 fragment_cubemap(Varying v) : SV_TARGET {
    float3 d = normalize(v.direction);
    // x is negated, and it is not optional. A cube map is sampled left-handed: looking along +Z the face puts +X on
    // the right of the picture. Matchbox is right-handed, where the camera looking along +Z has -X on its right.
    // Passing the world direction through unchanged gives a mirrored sky. Negating x here, rather than swapping faces
    // when they are uploaded, keeps the cross sliced by the labels it is drawn with, so what the loader cuts is what
    // a person sees in the file. The cost: the cell labelled +X is the one seen looking toward world -X
    return cube_sky.Sample(sky_sampler, float3(-d.x, d.y, d.z)) * tint;
}

float4 fragment_panorama(Varying v) : SV_TARGET {
    float3 d = normalize(v.direction);
    // The middle of the picture is straight ahead, down -Z, and u grows toward +X, the camera's right when it looks
    // down -Z, so the picture is not mirrored. atan2(x, -z) is 0 down -Z and pi/2 toward +X
    float u = atan2(d.x, -d.z) * 0.15915494309 + 0.5;
    // acos is 0 straight up, which is the top row: the zenith, where an equirectangular picture puts it
    float v_coordinate = acos(clamp(d.y, -1.0, 1.0)) * 0.31830988618;
    return panorama_sky.Sample(sky_sampler, float2(u, v_coordinate)) * tint;
}
