Data :: struct {
    texture_a: texture_id,
    s:         sampler_id,
    flip_x:    uint,
    flip_y:    uint,
}

main :: (uv: vec2 @input(0), data: ^Data @data) -> vec4 @output(0)
{
    uv_final:vec2 = uv;
    if data.flip_x != 0 { uv_final.x = 1.0 - uv_final.x; }
    if data.flip_y != 0 { uv_final.y = 1.0 - uv_final.y; }
    return texture_sample(data.texture_a, data.s, uv_final);
}

