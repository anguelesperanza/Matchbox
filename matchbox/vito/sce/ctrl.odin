// Enumeration for the digital controller buttons.
// @note - L1/R1/L3/R3 only can bind using ::sceCtrlPeekBufferPositiveExt2 and ::sceCtrlReadBufferPositiveExt2
// @note - Values bigger than 0x00010000 can be intercepted only with shell privileges
// @note - Vita's L Trigger and R Trigger are mapped to L1 and R1 when using ::sceCtrlPeekBufferPositiveExt2 and ::sceCtrlReadBufferPositiveExt2
CtrlButtons :: u32
CTRL_SELECT      :: 0x1 // Select button.
CTRL_L3          :: 0x2 // L3 button.
CTRL_R3          :: 0x4 // R3 button.
CTRL_START       :: 0x8 // Start button.
CTRL_UP          :: 0x10 // Up D-Pad button.
CTRL_RIGHT       :: 0x20 // Right D-Pad button.
CTRL_DOWN        :: 0x40 // Down D-Pad button.
CTRL_LEFT        :: 0x80 // Left D-Pad button.
CTRL_LTRIGGER    :: 0x100 // Left trigger.
CTRL_L2          :: 0x100 // L2 button.
CTRL_RTRIGGER    :: 0x200 // Right trigger.
CTRL_R2          :: 0x200 // R2 button.
CTRL_L1          :: 0x400 // L1 button.
CTRL_R1          :: 0x800 // R1 button.
CTRL_TRIANGLE    :: 0x1000 // Triangle button.
CTRL_CIRCLE      :: 0x2000 // Circle button.
CTRL_CROSS       :: 0x4000 // Cross button.
CTRL_SQUARE      :: 0x8000 // Square button.
CTRL_INTERCEPTED :: 0x00010000 // Input not available because intercepted by another application
CTRL_PSBUTTON    :: 0x00010000 // Playstation (Home) button.
CTRL_HEADPHONE   :: 0x00080000 // Headphone plugged in.
CTRL_VOLUP       :: 0x00100000 // Volume up button.
CTRL_VOLDOWN     :: 0x00200000 // Volume down button.
CTRL_POWER       :: 0x40000000 // Power button.

// Enumeration for the controller types.
CtrlExternalInputMode :: u32
CTRL_TYPE_UNPAIRED :: 0 // Unpaired controller
CTRL_TYPE_PHY      :: 1 // Physical controller for VITA
CTRL_TYPE_VIRT     :: 2 // Virtual controller for PSTV
CTRL_TYPE_DS3      :: 4 // DualShock 3
CTRL_TYPE_DS4      :: 8 // DualShock 4

// Controller mode.
CtrlPadInputMode :: enum u32 {
    DIGITAL     = 0,
    ANALOG      = 1,
    ANALOG_WIDE = 2,
}

