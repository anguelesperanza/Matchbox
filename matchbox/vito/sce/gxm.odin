// Texture memory layouts.
GxmTextureType :: enum u32 {
    SWIZZLED           = 0x0, // Swizzled memory layout with power of two width and height
    CUBE               = 0x40000000, // Cube memory layout with power of two width and height
    LINEAR             = 0x60000000, // Linear memory layout
    TILED              = 0x80000000, // Tiled memory layout
    SWIZZLED_ARBITRARY = 0xA0000000, // Swizzled memory layout with arbitrary width and height
    LINEAR_STRIDED     = 0xC0000000, // Linear memory layout with arbitrary stride
    CUBE_ARBITRARY     = 0xE0000000, // Cube memory layout with arbitrary width and height.
}

GxmTextureFilter :: enum u32 {
    POINT         = 0x0,
    LINEAR        = 0x1,
    MIPMAP_LINEAR = 0x2,
    MIPMAP_POINT  = 0x3,
}

GxmTextureMipFilter :: enum u32 {
    DISABLED = 0x0,
    ENABLED  = 0x200,
}

GxmTextureAddrMode :: enum u32 {
    REPEAT               = 0x0,
    MIRROR               = 0x1,
    CLAMP                = 0x2,
    MIRROR_CLAMP         = 0x3,
    REPEAT_IGNORE_BORDER = 0x4,
    CLAMP_FULL_BORDER    = 0x5,
    CLAMP_IGNORE_BORDER  = 0x6,
    CLAMP_HALF_BORDER    = 0x7,
}

GxmTextureGammaMode :: enum u32 {
    NONE = 0x0,
    R    = 0x08000000,
    GR   = 0x18000000,
    BGR  = 0x08000000,
}

GxmTextureNormalizeMode :: i32
GXM_TEXTURE_NORMALIZE_DISABLED :: 0x0
GXM_TEXTURE_NORMALIZE_ENABLED  :: 0x80000000 - 1<<32

// Indices formats.
GxmIndexFormat :: enum u32 {
    U16 = 0x0, // 16-bit unsigned integers
    U32 = 0x01000000, // 32-bit unsigned integers
}

// Vertex stream indexing formats.
GxmIndexSource :: u32
GXM_INDEX_SOURCE_INDEX_16BIT    :: 0x0 // 16-bit indexing. Values must be lower than 64000.
GXM_INDEX_SOURCE_INDEX_32BIT    :: 0x1 // 32-bit indexing.
GXM_INDEX_SOURCE_INSTANCE_16BIT :: 0x2 // 16-bit indexing for instanced draws. Values must be lower than 64000.
GXM_INDEX_SOURCE_INSTANCE_32BIT :: 0x3 // 32-bit indexing for instanced draws.

// Fragment program states.
GxmFragmentProgramMode :: enum u32 {
    DISABLED = 0x00200000, // Disabled
    ENABLED  = 0x0, // Enabled
}

// Depth write states.
GxmDepthWriteMode :: enum u32 {
    DISABLED = 0x00100000, // Disabled
    ENABLED  = 0x0, // Enabled
}

GxmLineFillLastPixelMode :: enum u32 {
    DISABLED = 0x0,
    ENABLED  = 0x00080000,
}

// Two sided rendering states.
GxmTwoSidedMode :: enum u32 {
    DISABLED = 0x0, // Disabled
    ENABLED  = 0x800, // Enabled
}

GxmWClampMode :: enum u32 {
    DISABLED = 0x0,
    ENABLED  = 0x8000,
}

// W-clamp states
GxmViewportMode :: enum u32 {
    DISABLED = 0x00010000, // Disabled
    ENABLED  = 0x0, // Enabled
}

// W-buffer mode states
GxmWBufferMode :: enum u32 {
    DISABLED = 0x0, // Disabled
    ENABLED  = 0x4000, // Enabled
}

GxmDepthStencilForceLoadMode :: enum u32 {
    DISABLED = 0x0,
    ENABLED  = 0x2,
}

GxmDepthStencilForceStoreMode :: enum u32 {
    DISABLED = 0x0,
    ENABLED  = 0x4,
}

GxmSceneFlags :: u32
GXM_SCENE_FRAGMENT_SET_DEPENDENCY    :: 0x1
GXM_SCENE_VERTEX_WAIT_FOR_DEPENDENCY :: 0x2
GXM_SCENE_FRAGMENT_TRANSFER_SYNC     :: 0x4
GXM_SCENE_VERTEX_TRANSFER_SYNC       :: 0x8

GxmMidSceneFlags :: u32
GXM_MIDSCENE_PRESERVE_DEFAULT_UNIFORM_BUFFERS :: 0x1

GxmColorSurfaceScaleMode :: enum u32 {
    NONE           = 0x0,
    MSAA_DOWNSCALE = 0x1,
}

GxmOutputRegisterSize :: enum u32 {
    _32BIT = 0x0,
    _64BIT = 0x1,
}

GxmVisibilityTestMode :: enum u32 {
    DISABLED = 0x0,
    ENABLED  = 0x4000,
}

GxmVisibilityTestOp :: enum u32 {
    INCREMENT = 0x0,
    SET       = 0x00040000,
}

GxmYuvProfile :: enum u32 {
    BT601_STANDARD   = 0,
    BT709_STANDARD   = 1,
    BT601_FULL_RANGE = 2,
    BT709_FULL_RANGE = 3,
}

GxmBlendFunc :: u32
GXM_BLEND_FUNC_NONE             :: 0
GXM_BLEND_FUNC_ADD              :: 1
GXM_BLEND_FUNC_SUBTRACT         :: 2
GXM_BLEND_FUNC_REVERSE_SUBTRACT :: 3
GXM_BLEND_FUNC_MIN              :: 4
GXM_BLEND_FUNC_MAX              :: 5

GxmBlendFactor :: u32
GXM_BLEND_FACTOR_ZERO                :: 0
GXM_BLEND_FACTOR_ONE                 :: 1
GXM_BLEND_FACTOR_SRC_COLOR           :: 2
GXM_BLEND_FACTOR_ONE_MINUS_SRC_COLOR :: 3
GXM_BLEND_FACTOR_SRC_ALPHA           :: 4
GXM_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA :: 5
GXM_BLEND_FACTOR_DST_COLOR           :: 6
GXM_BLEND_FACTOR_ONE_MINUS_DST_COLOR :: 7
GXM_BLEND_FACTOR_DST_ALPHA           :: 8
GXM_BLEND_FACTOR_ONE_MINUS_DST_ALPHA :: 9
GXM_BLEND_FACTOR_SRC_ALPHA_SATURATE  :: 10
GXM_BLEND_FACTOR_DST_ALPHA_SATURATE  :: 11

GxmColorMask :: u32
GXM_COLOR_MASK_NONE :: 0x0
GXM_COLOR_MASK_A    :: 0x1
GXM_COLOR_MASK_R    :: 0x2
GXM_COLOR_MASK_G    :: 0x4
GXM_COLOR_MASK_B    :: 0x8
GXM_COLOR_MASK_ALL  :: 0xF

GxmTransferFormat :: enum u32 {
    U8_R             = 0x0,
    U4U4U4U4_ABGR    = 0x00010000,
    U1U5U5U5_ABGR    = 0x00020000,
    U5U6U5_BGR       = 0x00030000,
    U8U8_GR          = 0x00040000,
    U8U8U8_BGR       = 0x00050000,
    U8U8U8U8_ABGR    = 0x00060000,
    VYUY422          = 0x00070000,
    YVYU422          = 0x00080000,
    UYVY422          = 0x00090000,
    YUYV422          = 0x000A0000,
    U2U10U10U10_ABGR = 0x000D0000,
    RAW16            = 0x000F0000,
    RAW32            = 0x00110000,
    RAW64            = 0x00120000,
    RAW128           = 0x00130000,
}

GxmTransferFlags :: u32
GXM_TRANSFER_FRAGMENT_SYNC :: 0x1
GXM_TRANSFER_VERTEX_SYNC   :: 0x2

GxmTransferColorKeyMode :: enum u32 {
    NONE   = 0,
    PASS   = 1,
    REJECT = 2,
}

// Transfer operation memory layouts
GxmTransferType :: enum u32 {
    LINEAR   = 0x0, // Linear memory layout.
    TILED    = 0x00400000, // Tiled memory layout.
    SWIZZLED = 0x00800000, // Swizzled memory layout.
}

GxmBlendInfo :: struct {
    colorMask:  u8, // Color Mask (One of ::SceGxmColorMask).
    using _bf0: bit_field u8 {colorFunc: u8 | 4, alphaFunc: u8 | 4},
    using _bf1: bit_field u8 {colorSrc: u8 | 4, colorDst: u8 | 4},
    using _bf2: bit_field u8 {alphaSrc: u8 | 4, alphaDst: u8 | 4},
}
#assert(size_of(GxmBlendInfo) == 0x4)

GxmRenderTarget :: struct {} // opaque
GxmSyncObject :: struct {} // opaque

GxmVertexAttribute :: struct {
    streamIndex:    u16, // Vertex stream index.
    offset:         u16, // Offset for the stream data in bytes.
    format:         u8, // Stream data type (One of ::SceGxmAttributeFormat).
    componentCount: u8, // Number of components for the stream data.
    regIndex:       u16, // The register index in the vertex shader to link stream to.
}
#assert(size_of(GxmVertexAttribute) == 0x8)

GxmVertexStream :: struct {
    stride:      u16, // Stride (in bytes) between each element of the stream.
    indexSource: u16, // Indexing mode (One of ::SceGxmIndexSource).
}
#assert(size_of(GxmVertexStream) == 0x4)

// Texture struct
GxmTexture :: struct {
    using _anon0: struct #raw_union {
            generic:        struct {
                using _bf0: bit_field u32 {unk0: u32 | 1, stride_ext: u32 | 2, vaddr_mode: u32 | 3, uaddr_mode: u32 | 3, mip_filter: u32 | 1, min_filter: u32 | 2, mag_filter: u32 | 2, unk1: u32 | 3, mip_count: u32 | 4, lod_bias: u32 | 6, gamma_mode: u32 | 2, unk2: u32 | 2, format0: u32 | 1},
            },
            linear_strided: struct {
                using _bf0: bit_field u32 {unk0: u32 | 1, stride_ext: u32 | 2, vaddr_mode: u32 | 3, uaddr_mode: u32 | 3, stride_low: u32 | 3, mag_filter: u32 | 2, unk1: u32 | 3, stride: u32 | 10, gamma_mode: u32 | 2, unk2: u32 | 2, format0: u32 | 1},
            },
        },
    using _anon1: struct #raw_union {
            generic2:      struct {
                using _bf0: bit_field u32 {height: u32 | 12, width: u32 | 12, base_format: u32 | 5, type: u32 | 3},
            },
            swizzled_cube: struct {
                using _bf0: bit_field u32 {height_pot: u32 | 4, reserved0: u32 | 12, width_pot: u32 | 4, reserved1: u32 | 4, base_format: u32 | 5, type: u32 | 3},
            },
        },
    using _bf0:   bit_field u32 {lod_min0: u32 | 2, data_addr: u32 | 30},
    using _bf1:   bit_field u32 {palette_addr: u32 | 26, lod_min1: u32 | 2, swizzle_format: u32 | 3, normalize_mode: u32 | 1},
}
#assert(size_of(GxmTexture) == 0x10)

GxmCommandList :: struct {
    words: [8]u32, // Internal control words.
}
#assert(size_of(GxmCommandList) == 0x20)

GxmColorSurface :: struct {
    pbeSidebandWord:    u32,
    pbeEmitWords:       [6]u32,
    outputRegisterSize: u32,
    backgroundTex:      GxmTexture,
}
#assert(size_of(GxmColorSurface) == 0x30)

GxmDepthStencilSurface :: struct {
    zlsControl:        u32,
    depthData:         rawptr,
    stencilData:       rawptr,
    backgroundDepth:   f32,
    backgroundControl: u32,
}
#assert(size_of(GxmDepthStencilSurface) == 0x14)

GxmNotification :: struct {
    address: ^u32,
    value:   u32,
}
#assert(size_of(GxmNotification) == 0x8)

GxmValidRegion :: struct {
    xMax: u32, // Maximum X value of the region in pixels.
    yMax: u32, // Maximum Y value of the region in pixels.
}
#assert(size_of(GxmValidRegion) == 0x8)

GxmContext :: struct {} // opaque
GXM_MINIMUM_CONTEXT_HOST_MEM_SIZE :: 2048
GXM_DEFAULT_PARAMETER_BUFFER_SIZE :: 16777216
GXM_DEFAULT_VDM_RING_BUFFER_SIZE :: 131072
GXM_DEFAULT_VERTEX_RING_BUFFER_SIZE :: 2097152
GXM_DEFAULT_FRAGMENT_RING_BUFFER_SIZE :: 524288
GXM_DEFAULT_FRAGMENT_USSE_RING_BUFFER_SIZE :: 16384

GxmContextParams :: struct {
    hostMem:                       rawptr,
    hostMemSize:                   Size,
    vdmRingBufferMem:              rawptr,
    vdmRingBufferMemSize:          Size,
    vertexRingBufferMem:           rawptr,
    vertexRingBufferMemSize:       Size,
    fragmentRingBufferMem:         rawptr,
    fragmentRingBufferMemSize:     Size,
    fragmentUsseRingBufferMem:     rawptr,
    fragmentUsseRingBufferMemSize: Size,
    fragmentUsseRingBufferOffset:  u32,
}
#assert(size_of(GxmContextParams) == 0x2C)

GxmDeferredContextParams :: struct {
    hostMem:                   rawptr,
    hostMemSize:               Size,
    vdmCallback:               proc "c" (args: rawptr, requestedSize: Size, size: ^Size) -> rawptr,
    vertexCallback:            proc "c" (args: rawptr, requestedSize: Size, size: ^Size) -> rawptr,
    fragmentCallback:          proc "c" (args: rawptr, requestedSize: Size, size: ^Size) -> rawptr,
    callbackData:              rawptr,
    vdmRingBufferMem:          rawptr,
    vdmRingBufferMemSize:      Size,
    vertexRingBufferMem:       rawptr,
    vertexRingBufferMemSize:   Size,
    fragmentRingBufferMem:     rawptr,
    fragmentRingBufferMemSize: Size,
}
#assert(size_of(GxmDeferredContextParams) == 0x30)

GxmVertexProgram :: struct {} // opaque
GxmFragmentProgram :: struct {} // opaque

GxmPrecomputedWordCount :: u32
GXM_PRECOMPUTED_VERTEX_STATE_WORD_COUNT   :: 7
GXM_PRECOMPUTED_FRAGMENT_STATE_WORD_COUNT :: 9
GXM_PRECOMPUTED_DRAW_WORD_COUNT           :: 11

GxmPrecomputedVertexState :: struct {
    data: [7]u32,
}
#assert(size_of(GxmPrecomputedVertexState) == 0x1C)

GxmPrecomputedFragmentState :: struct {
    data: [9]u32,
}
#assert(size_of(GxmPrecomputedFragmentState) == 0x24)

GxmPrecomputedDraw :: struct {
    data: [11]u32,
}
#assert(size_of(GxmPrecomputedDraw) == 0x2C)

GXM_MAX_VERTEX_ATTRIBUTES :: 16
GXM_MAX_VERTEX_STREAMS :: 16
GXM_MAX_TEXTURE_UNITS :: 16
GXM_MAX_UNIFORM_BUFFERS :: 14
GXM_TILE_SHIFTX :: 5
GXM_TILE_SHIFTY :: 5
GXM_TILE_SIZEX :: 0x20
GXM_TILE_SIZEY :: 0x20
GXM_COLOR_SURFACE_ALIGNMENT :: 4
GXM_TEXTURE_ALIGNMENT :: 16
GXM_DEPTHSTENCIL_SURFACE_ALIGNMENT :: 16
GXM_PALETTE_ALIGNMENT :: 64
GxmProgram :: struct {} // opaque
GxmProgramParameter :: struct {} // opaque

GxmProgramType :: enum u32 {
    VERTEX_PROGRAM   = 0, // Vertex shader program
    FRAGMENT_PROGRAM = 1, // Fragment shader program
}

GxmParameterCategory :: enum u32 {
    ATTRIBUTE      = 0, // Vertex attribute input
    UNIFORM        = 1, // Uniform
    SAMPLER        = 2, // Sampler
    UNIFORM_BUFFER = 4, // Uniform buffer
}

GxmParameterType :: enum u32 {
    F32       = 0,
    F16       = 1,
    C10       = 2,
    U32       = 3,
    S32       = 4,
    U16       = 5,
    S16       = 6,
    U8        = 7,
    S8        = 8,
    AGGREGATE = 9,
}

GxmParameterSemantic :: enum u32 {
    NONE         = 0,
    ATTR         = 1,
    BCOL         = 2,
    BINORMAL     = 3,
    BLENDINDICES = 4,
    BLENDWEIGHT  = 5,
    COLOR        = 6,
    DIFFUSE      = 7,
    FOGCOORD     = 8,
    NORMAL       = 9,
    POINTSIZE    = 10,
    POSITION     = 11,
    SPECULAR     = 12,
    TANGENT      = 13,
    TEXCOORD     = 14,
}

GxmShaderPatcher :: struct {} // opaque
GxmRegisteredProgram :: struct {} // opaque
GxmShaderPatcherId :: ^GxmRegisteredProgram
GxmShaderPatcherHostAllocCallback :: #type proc "c" (userData: rawptr, size: Size) -> rawptr
GxmShaderPatcherHostFreeCallback :: #type proc "c" (userData: rawptr, mem: rawptr)
GxmShaderPatcherBufferAllocCallback :: #type proc "c" (userData: rawptr, size: Size) -> rawptr
GxmShaderPatcherBufferFreeCallback :: #type proc "c" (userData: rawptr, mem: rawptr)
GxmShaderPatcherUsseAllocCallback :: #type proc "c" (userData: rawptr, size: Size, usseOffset: ^u32) -> rawptr
GxmShaderPatcherUsseFreeCallback :: #type proc "c" (userData: rawptr, mem: rawptr)

GxmShaderPatcherParams :: struct {
    userData:                  rawptr,
    hostAllocCallback:         GxmShaderPatcherHostAllocCallback,
    hostFreeCallback:          GxmShaderPatcherHostFreeCallback,
    bufferAllocCallback:       GxmShaderPatcherBufferAllocCallback,
    bufferFreeCallback:        GxmShaderPatcherBufferFreeCallback,
    bufferMem:                 rawptr,
    bufferMemSize:             Size,
    vertexUsseAllocCallback:   GxmShaderPatcherUsseAllocCallback,
    vertexUsseFreeCallback:    GxmShaderPatcherUsseFreeCallback,
    vertexUsseMem:             rawptr,
    vertexUsseMemSize:         Size,
    vertexUsseOffset:          u32,
    fragmentUsseAllocCallback: GxmShaderPatcherUsseAllocCallback,
    fragmentUsseFreeCallback:  GxmShaderPatcherUsseFreeCallback,
    fragmentUsseMem:           rawptr,
    fragmentUsseMemSize:       Size,
    fragmentUsseOffset:        u32,
}
#assert(size_of(GxmShaderPatcherParams) == 0x44)

GxmRenderTargetFlags :: u32
GXM_RENDER_TARGET_CUSTOM_MULTISAMPLE_LOCATIONS :: 0x1

GxmRenderTargetParams :: struct {
    flags:                u32, // Bitwise combined flags from ::SceGxmRenderTargetFlags.
    width:                u16, // The width of the render target in pixels.
    height:               u16, // The height of the render target in pixels.
    scenesPerFrame:       u16, // The expected number of scenes per frame, in the range [1,SCE_GXM_MAX_SCENES_PER_RENDERTARGET].
    multisampleMode:      u16, // Multisample mode to use (One of ::SceGxmMultisampleMode).
    multisampleLocations: u32, // If enabled in the flags, the multisample locations to use.
    driverMemBlock:       UID, // The uncached LPDDR memblock for the render target GPU data structures or SCE_UID_INVALID_UID to specify memory should be allocated in sceGxm.
}
#assert(size_of(GxmRenderTargetParams) == 0x14)

@(default_calling_convention = "c")
foreign lib_sce_gxm {
    // Initialize sceGxm library.
    //
    // @param[in] params - Pointer to a ::SceGxmInitializeParams structure.
    //
    // @return 0 on success, < 0 on error.
    // @note - flags field in the params struct must be set to SCE_GXM_INITIALIZE_FLAG_DEFAULT.
    sceGxmInitialize :: proc(params: ^GxmInitializeParams) -> i32 ---

    // Initialize sceGxm library with extra flags support.
    //
    // @param[in] params - Pointer to a ::SceGxmInitializeParams structure.
    //
    // @return 0 on success, < 0 on error.
    sceGxmVshInitialize :: proc(params: ^GxmInitializeParams) -> i32 ---

    // Terminate sceGxm library.
    //
    // @return 0 on success, < 0 on error.
    sceGxmTerminate :: proc() -> i32 ---

    sceGxmGetNotificationRegion :: proc() -> ^u32 ---

    sceGxmNotificationWait :: proc(notification: ^GxmNotification) -> i32 ---

    // Map memory region for GPU usage.
    //
    // @param[in] base - Base address of the memory region to map.
    // @param[in] size - Size in bytes of the memory region to map.
    // @param[in] attr - GPU read/write privileges to assign to the memory region.
    //
    // @return 0 on success, < 0 on error.
    sceGxmMapMemory :: proc(base: rawptr, size: Size, attr: GxmMemoryAttribFlags) -> i32 ---

    // Unmap memory region for GPU usage.
    //
    // @param[in] base - Base address of the memory region to unmap.
    //
    // @return 0 on success, < 0 on error.
    sceGxmUnmapMemory :: proc(base: rawptr) -> i32 ---

    // Map memory region for vertex USSE code usage.
    //
    // @param[in] base - Base address of the memory region to map.
    // @param[in] size - Size in bytes of the memory region to map.
    // @param[out] offset - Resulting offset for the given memory region, to be used with ::sceGxmShaderPatcherCreate.
    //
    // @return 0 on success, < 0 on error.
    sceGxmMapVertexUsseMemory :: proc(base: rawptr, size: Size, offset: ^u32) -> i32 ---

    // Unmap memory region for vertex USSE code usage.
    //
    // @param[in] base - Base address of the memory region to unmap.
    //
    // @return 0 on success, < 0 on error.
    sceGxmUnmapVertexUsseMemory :: proc(base: rawptr) -> i32 ---

    // Map memory region for fragment USSE code usage.
    //
    // @param[in] base - Base address of the memory region to map.
    // @param[in] size - Size in bytes of the memory region to map.
    // @param[out] offset - Resulting offset for the given memory region, to be used with ::sceGxmShaderPatcherCreate.
    //
    // @return 0 on success, < 0 on error.
    sceGxmMapFragmentUsseMemory :: proc(base: rawptr, size: Size, offset: ^u32) -> i32 ---

    // Unmap memory region for fragment USSE code usage.
    //
    // @param[in] base - Base address of the memory region to unmap.
    //
    // @return 0 on success, < 0 on error.
    sceGxmUnmapFragmentUsseMemory :: proc(base: rawptr) -> i32 ---

    // Add a new display swap request to the display queue.
    //
    // @param[in] oldBuffer - Synchronization object associated to the previous frame buffer.
    // @param[in] newBuffer - Synchronization object associated to the new incoming frame buffer.
    // @param[in] callbackData - Data to send to the display swap callback.
    //
    // @return 0 on success, < 0 on error.
    sceGxmDisplayQueueAddEntry :: proc(oldBuffer: ^GxmSyncObject, newBuffer: ^GxmSyncObject, callbackData: rawptr) -> i32 ---

    // Wait until all pending display swaps finished.
    //
    // @return 0 on success, < 0 on error.
    sceGxmDisplayQueueFinish :: proc() -> i32 ---

    // Create a new synchronization object.
    //
    // @param[out] syncObject - Pointer to the newly created synchronization object.
    //
    // @return 0 on success, < 0 on error.
    sceGxmSyncObjectCreate :: proc(syncObject: ^^GxmSyncObject) -> i32 ---

    // Destroy a synchronization object.
    //
    // @param[in] syncObject - Pointer to the synchronization object to destroy.
    //
    // @return 0 on success, < 0 on error.
    sceGxmSyncObjectDestroy :: proc(syncObject: ^GxmSyncObject) -> i32 ---

    // Create a sceGxm context for immediate draw calls.
    //
    // @param[in] params - Pointer to a ::SceGxmContextParams structure.
    // @param[out] context - Pointer to the created sceGxm context.
    //
    // @return 0 on success, < 0 on error.
    sceGxmCreateContext :: proc(params: ^GxmContextParams, context_: ^^GxmContext) -> i32 ---

    // Destroy a sceGxm context for immediate draw calls.
    //
    // @param[in] context - Pointer to the context to destroy.
    //
    // @return 0 on success, < 0 on error.
    sceGxmDestroyContext :: proc(context_: ^GxmContext) -> i32 ---

    // Create a sceGxm context for deferred draw calls.
    //
    // @param[in] params - Pointer to a ::SceGxmDeferredContextParams structure.
    // @param[out] context - Pointer to the created sceGxm context.
    //
    // @return 0 on success, < 0 on error.
    sceGxmCreateDeferredContext :: proc(params: ^GxmDeferredContextParams, context_: ^^GxmContext) -> i32 ---

    // Destroy a sceGxm context for deferred draw calls.
    //
    // @param[in] context - Pointer to the context to destroy.
    //
    // @return 0 on success, < 0 on error.
    sceGxmDestroyDeferredContext :: proc(context_: ^GxmContext) -> i32 ---

    // Enables debug validation during execution.
    //
    // @param[in] context - The sceGxm context whether to enable validation.
    // @param[in] enable - Whether to enable or disable validation.
    //
    // @return 0 on success, < 0 on error.
    // @note This function has effect only when debug version of sceGxm is being used.
    sceGxmSetValidationEnable :: proc(context_: ^GxmContext, enable: Bool) ---

    // Set the currently active vertex shader program.
    //
    // @param[in] context - The sceGxm context to use.
    // @param[in] vertexProgram - The vertex shader program to activate.
    //
    // @return 0 on success, < 0 on error.
    sceGxmSetVertexProgram :: proc(context_: ^GxmContext, vertexProgram: ^GxmVertexProgram) ---

    // Set the currently active fragment shader program.
    //
    // @param[in] context - The sceGxm context to use.
    // @param[in] fragmentProgram - The fragment shader program to activate.
    //
    // @return 0 on success, < 0 on error.
    sceGxmSetFragmentProgram :: proc(context_: ^GxmContext, fragmentProgram: ^GxmFragmentProgram) ---

    sceGxmReserveVertexDefaultUniformBuffer :: proc(context_: ^GxmContext, uniformBuffer: ^rawptr) -> i32 ---

    sceGxmReserveFragmentDefaultUniformBuffer :: proc(context_: ^GxmContext, uniformBuffer: ^rawptr) -> i32 ---

    sceGxmSetVertexDefaultUniformBuffer :: proc(context_: ^GxmContext, uniformBuffer: rawptr) -> i32 ---

    sceGxmSetFragmentDefaultUniformBuffer :: proc(context_: ^GxmContext, uniformBuffer: rawptr) -> i32 ---

    // Set an active vertex stream for future draw calls.
    //
    // @param[in] context - The sceGxm context to use.
    // @param[in] streamIndex - The vertex stream index to bind.
    // @param[in] streamData - The data to pass on the given vertex stream.
    //
    // @return 0 on success, < 0 on error.
    sceGxmSetVertexStream :: proc(context_: ^GxmContext, streamIndex: u32, streamData: rawptr) -> i32 ---

    // Set an active texture for vertex shader stage for future draw calls.
    //
    // @param[in] context - The sceGxm context to use.
    // @param[in] textureIndex - The texture unit to bind.
    // @param[in] texture - The texture to bind to the given texture unit.
    //
    // @return 0 on success, < 0 on error.
    sceGxmSetVertexTexture :: proc(context_: ^GxmContext, textureIndex: u32, texture: ^GxmTexture) -> i32 ---

    // Set an active texture for fragment shader stage for future draw calls.
    //
    // @param[in] context - The sceGxm context to use.
    // @param[in] textureIndex - The texture unit to bind.
    // @param[in] texture - The texture to bind to the given texture unit.
    //
    // @return 0 on success, < 0 on error.
    sceGxmSetFragmentTexture :: proc(context_: ^GxmContext, textureIndex: u32, texture: ^GxmTexture) -> i32 ---

    sceGxmSetVertexUniformBuffer :: proc(context_: ^GxmContext, bufferIndex: u32, bufferData: rawptr) -> i32 ---

    sceGxmSetFragmentUniformBuffer :: proc(context_: ^GxmContext, bufferIndex: u32, bufferData: rawptr) -> i32 ---

    sceGxmSetPrecomputedFragmentState :: proc(context_: ^GxmContext, precomputedState: ^GxmPrecomputedFragmentState) ---

    sceGxmSetPrecomputedVertexState :: proc(context_: ^GxmContext, precomputedState: ^GxmPrecomputedVertexState) ---

    sceGxmDrawPrecomputed :: proc(context_: ^GxmContext, precomputedDraw: ^GxmPrecomputedDraw) -> i32 ---

    sceGxmDraw :: proc(context_: ^GxmContext, primType: GxmPrimitiveType, indexType: GxmIndexFormat, indexData: rawptr, indexCount: u32) -> i32 ---

    sceGxmDrawInstanced :: proc(context_: ^GxmContext, primType: GxmPrimitiveType, indexType: GxmIndexFormat, indexData: rawptr, indexCount: u32, indexWrap: u32) -> i32 ---

    sceGxmSetVisibilityBuffer :: proc(context_: ^GxmContext, bufferBase: rawptr, stridePerCore: u32) -> i32 ---

    sceGxmBeginScene :: proc(context_: ^GxmContext, flags: u32, renderTarget: ^GxmRenderTarget, validRegion: ^GxmValidRegion, vertexSyncObject: ^GxmSyncObject, fragmentSyncObject: ^GxmSyncObject, colorSurface: ^GxmColorSurface, depthStencil: ^GxmDepthStencilSurface) -> i32 ---

    sceGxmMidSceneFlush :: proc(context_: ^GxmContext, flags: u32, vertexSyncObject: ^GxmSyncObject, vertexNotification: ^GxmNotification) -> i32 ---

    sceGxmEndScene :: proc(context_: ^GxmContext, vertexNotification: ^GxmNotification, fragmentNotification: ^GxmNotification) -> i32 ---

    // Init generation of a new command list.
    //
    // @param[in] context - The sceGxm context to use.
    //
    // @return 0 on success, < 0 on error.
    sceGxmBeginCommandList :: proc(context_: ^GxmContext) -> i32 ---

    // Execute a command list.
    //
    // @param[in] context - The sceGxm context to use.
    // @param[in] list - The command list to execute.
    //
    // @return 0 on success, < 0 on error.
    sceGxmExecuteCommandList :: proc(context_: ^GxmContext, list: ^GxmCommandList) -> i32 ---

    // Finalize the generation of a new command list.
    //
    // @param[in] context - The sceGxm context to use.
    // @param[out] list - The finalized command list. Can be executed with ::sceGxmExecuteCommandList.
    //
    // @return 0 on success, < 0 on error.
    sceGxmEndCommandList :: proc(context_: ^GxmContext, list: ^GxmCommandList) -> i32 ---

    sceGxmSetFrontDepthFunc :: proc(context_: ^GxmContext, depthFunc: GxmDepthFunc) ---

    sceGxmSetBackDepthFunc :: proc(context_: ^GxmContext, depthFunc: GxmDepthFunc) ---

    sceGxmSetFrontFragmentProgramEnable :: proc(context_: ^GxmContext, enable: GxmFragmentProgramMode) ---

