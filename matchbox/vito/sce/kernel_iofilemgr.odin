S_IWGRP :: 0o0 // Group write permission. Ignored and reset to 0 by system
S_IRGRP :: 0o0 // Group read permission. Ignored and reset to 0 by system
S_IRWXG :: 0o0 // Group access rights mask. Ignored and reset to 0 by system
