package mbsc

import "core:fmt"
import "core:mem/virtual"
import "core:strconv"
import "core:strings"

// The HLSL backend (S2): the intermediate form (ir.odin) written as Shader Model 5 source for Direct3D 11.
//
// What the output relies on, and why:
//   - The engine uploads a matrix in Odin's layout, which HLSL reads as column-major, so `m * v` is `mul(m, v)`
//     and `v * m` is `mul(v, m)`. Matrix times matrix is `mul` as well, since HLSL's own `*` is per element.
//   - The engine's constant buffers have a fixed layout (FRAME_FIELDS and RENDER_FIELDS in engine.odin), so each is
//     written with every engine field in the engine's order, whatever subset the shader declared. Their fields are
//     named `<block>_<field>`, because HLSL puts constant buffer fields in the global scope.
//   - A struct has no constructor expression in HLSL, so each struct a shader builds gets a small `mbs_make_` helper.
//   - Every texture shares the one sampler at register s0, which is the one the runtime binds.

// Registers the runtime binds: frame at b0, render at b1. The game's own uniforms come after, at b2.
// The registers the generated HLSL uses, also written to the reflection file for the runtime.
FRAME_REGISTER :: 0
RENDER_REGISTER :: 1
GAME_REGISTER :: 2
SAMPLER_REGISTER :: 0

@(private = "file")
SAMPLER_NAME :: "mbs_sampler"

// Words a shader can't use as names in HLSL, and intrinsics it would hide. A shader name that matches one gets
// `mbs_` in front of it.
@(rodata, private = "file")
RESERVED := [?]string {
	// keywords
	"asm", "bool", "break", "buffer", "case", "cbuffer", "centroid", "class", "column_major", "compile", "const",
	"continue", "default", "discard", "do", "double", "else", "extern", "false", "float", "for", "groupshared",
	"half", "if", "in", "inline", "inout", "int", "interface", "line", "lineadj", "linear", "matrix", "namespace",
	"nointerpolation", "noperspective", "out", "packoffset", "pixelshader", "point", "precise", "register",
	"return", "row_major", "sample", "sampler", "SamplerState", "shared", "snorm", "static", "string", "struct",
	"switch", "tbuffer", "technique", "Texture2D", "texture", "triangle", "triangleadj", "true", "typedef",
	"uint", "uniform", "unorm", "unsigned", "vector", "vertexshader", "void", "volatile", "while",
	// intrinsics a shader could be tempted to name something after
	"abs", "acos", "all", "any", "asin", "atan", "atan2", "ceil", "clamp", "clip", "cos", "cosh", "cross", "ddx",
	"ddy", "degrees", "determinant", "distance", "dot", "exp", "exp2", "floor", "fmod", "frac", "fwidth",
	"isfinite", "isinf", "isnan", "ldexp", "length", "lerp", "lit", "log", "log10", "log2", "mad", "max", "min",
	"modf", "mul", "normalize", "pow", "radians", "rcp", "reflect", "refract", "round", "rsqrt", "saturate",
	"sign", "sin", "sincos", "sinh", "smoothstep", "sqrt", "step", "tan", "tanh", "transpose", "trunc",
}

@(private = "file")
Hlsl :: struct {
	ir:          ^IR_Module,
	problems:    [dynamic]string,
	globals:     map[string]bool, // names taken at the top level
	names:       map[^IR_Var]string, // what each variable of the procedure being written is called
	helpers:     [dynamic]string, // structs the shader builds, in the order they were first met
	helper_seen: map[string]bool,
	math:        [dynamic]Math_Helper, // built-ins that become a small function, in the order they were first met
	math_seen:   map[string]bool,
	current:     string, // the procedure being written
	calls:       map[string][dynamic]string, // the procedures each procedure calls
	samples:     map[string]bool, // the procedures that call `sample`
	lights:      bool, // a light built-in is called: the lights block and its functions are written
}

// Where a `sample` goes in the text of a procedure, until it's known which stage the procedure runs in: the
// vertex stage has no screen-space derivatives, so HLSL only lets it sample with an explicit level.
@(private = "file")
SAMPLE_METHOD :: "\x01M"

@(private = "file")
SAMPLE_LEVEL :: "\x01L"

// generate_hlsl writes the module as HLSL. `problems` lists what this backend can't write yet; when it isn't empty
// the text is not complete. Both are allocated with `allocator`.
generate_hlsl :: proc(ir: ^IR_Module, allocator := context.allocator) -> (text: string, problems: []string) {
	// The text is built in a scratch arena, because writing it allocates many small strings.
	scratch: virtual.Arena
	_ = virtual.arena_init_growing(&scratch)
	defer virtual.arena_destroy(&scratch)
	context.allocator = virtual.arena_allocator(&scratch)

	h := Hlsl {
		ir = ir,
	}
	builder := strings.builder_make()
	strings.write_string(&builder, "// Generated by mbsc. Edit the .mbs shader and generate this file again; changes made here are lost.\n")

	reserve_global_names(&h)
	write_structs(&h, &builder)
	write_constant_buffers(&h, &builder)
	write_textures(&h, &builder)

	// The procedures are written first, so that the helpers they need are known, and then put after the structs.
	bodies := make([dynamic]string)
	for info in ir.procs {
		piece := strings.builder_make()
		h.current = info.name
		write_proc(&h, &piece, info)
		append(&bodies, strings.to_string(piece))
	}
	in_vertex := reachable_from(&h, ir.vertex_main)
	in_fragment := reachable_from(&h, ir.fragment_main)
	body := strings.builder_make()
	for info, index in ir.procs {
		chunk := bodies[index]
		if h.samples[info.name] {
			if in_vertex[info.name] && in_fragment[info.name] {
				problem(&h, fmt.aprintf("`%s` samples a texture and runs in both stages; HLSL samples differently in each", info.name))
			}
			if in_vertex[info.name] {
				chunk, _ = strings.replace_all(chunk, SAMPLE_METHOD, "SampleLevel")
				chunk, _ = strings.replace_all(chunk, SAMPLE_LEVEL, ", 0.0")
			} else {
				chunk, _ = strings.replace_all(chunk, SAMPLE_METHOD, "Sample")
				chunk, _ = strings.replace_all(chunk, SAMPLE_LEVEL, "")
			}
		}
		strings.write_string(&body, chunk)
	}
	write_helpers(&h, &builder)
	strings.write_string(&builder, strings.to_string(body))

	kept_problems := make([]string, len(h.problems), allocator)
	for problem, index in h.problems {
		kept_problems[index] = strings.clone(problem, allocator)
	}
	return strings.clone(strings.to_string(builder), allocator), kept_problems
}

// reachable_from is the names of the procedures an entry point runs, itself included.
@(private = "file")
reachable_from :: proc(h: ^Hlsl, entry: ^IR_Proc) -> map[string]bool {
	seen := make(map[string]bool)
	if entry == nil {
		return seen
	}
	pending := make([dynamic]string)
	append(&pending, entry.name)
	for len(pending) > 0 {
		name := pop(&pending)
		if seen[name] {
			continue
		}
		seen[name] = true
		for callee in h.calls[name] {
			append(&pending, callee)
		}
	}
	return seen
}

// ---- names ------------------------------------------------------------------------------------------------

@(private = "file")
is_reserved :: proc(name: string) -> bool {
	for word in RESERVED {
		if word == name {
			return true
		}
	}
	return false
}

// safe_name is a shader's name as HLSL can take it.
@(private = "file")
safe_name :: proc(name: string) -> string {
	if is_reserved(name) || strings.has_prefix(name, "mbs_") {
		return strings.concatenate({"mbs_", name})
	}
	return name
}

@(private = "file")
reserve_global_names :: proc(h: ^Hlsl) {
	for info in h.ir.structs {
		h.globals[safe_name(info.name)] = true
	}
	for texture in h.ir.textures {
		h.globals[safe_name(texture.name)] = true
	}
	for uniform in h.ir.uniforms {
		if uniform.kind == .GAME {
			h.globals[safe_name(uniform.name)] = true
		} else {
			for field in engine_fields(uniform.kind) {
				h.globals[block_field_name(uniform.name, field.name)] = true
			}
		}
	}
	for info in h.ir.procs {
		h.globals[safe_name(info.name)] = true
	}
	h.globals[SAMPLER_NAME] = true
}

@(private = "file")
block_field_name :: proc(block, field: string) -> string {
	return strings.concatenate({safe_name(block), "_", field})
}

@(private = "file")
engine_fields :: proc(kind: Uniform_Kind) -> []Engine_Field {
	#partial switch kind {
	case .FRAME:
		return FRAME_FIELDS[:]
	case .RENDER:
		return RENDER_FIELDS[:]
	}
	return nil
}

// local_name picks the name of a variable. It keeps the shader's own name unless another variable of the
// procedure, or something at the top level, already has it; then the variable's number is added.
@(private = "file")
local_name :: proc(h: ^Hlsl, taken: ^map[string]bool, var: ^IR_Var) -> string {
	candidate := safe_name(var.name)
	if var.name == "_" {
		candidate = "unused"
	}
	if taken[candidate] || h.globals[candidate] || candidate == "unused" {
		candidate = fmt.aprintf("%s_%d", candidate, var.id)
	}
	taken[candidate] = true
	h.names[var] = candidate
	return candidate
}

// ---- types ------------------------------------------------------------------------------------------------

// base_type is a type without any array part: `float4`, `float4x4`, `Varying`.
@(private = "file")
base_type :: proc(h: ^Hlsl, type: ^Type) -> string {
	#partial switch type.kind {
	case .BOOL:
		return "bool"
	case .F32:
		return "float"
	case .I32:
		return "int"
	case .U32:
		return "uint"
	case .VECTOR:
		return fmt.aprintf("%s%d", base_type(h, type.elem), type.count)
	case .MATRIX:
		return fmt.aprintf("float%dx%d", type.rows, type.cols)
	case .ARRAY:
		return base_type(h, type.elem)
	case .STRUCT:
		return safe_name(type.info.name)
	case .TEXTURE2D:
		return "Texture2D"
	}
	return "void"
}

// array_suffix is `[2][3]` for the array part of a type, outermost first, and "" for a type that isn't an array.
@(private = "file")
array_suffix :: proc(type: ^Type) -> string {
	suffix := ""
	current := type
	for current.kind == .ARRAY {
		suffix = fmt.aprintf("%s[%d]", suffix, current.count)
		current = current.elem
	}
	return suffix
}

// declarator is a name with its type, the way HLSL writes it: `float4 a[3]`.
@(private = "file")
declarator :: proc(h: ^Hlsl, type: ^Type, name: string) -> string {
	return fmt.aprintf("%s %s%s", base_type(h, type), name, array_suffix(type))
}

// engine_type turns the engine tables' type spelling into HLSL.
@(private = "file")
engine_type :: proc(key: string) -> string {
	switch {
	case key == "f32":
		return "float"
	case key == "[2]f32":
		return "float2"
	case key == "[3]f32":
		return "float3"
	case key == "[4]f32":
		return "float4"
	case strings.has_prefix(key, "matrix[") && len(key) == len("matrix[4,4]f32"):
		return fmt.aprintf("float%cx%c", key[7], key[9])
	}
	return "float"
}

// semantic is what an `attr:` or `out:` tag means in HLSL.
@(private = "file")
semantic :: proc(field: IR_Field_Info) -> string {
	if field.attr != "" {
		return field.attr
	}
	switch field.out {
	case "":
		return ""
	case "position":
		return "SV_POSITION"
	case "color":
		return "COLOR"
	case "texcoord0":
		return "TEXCOORD0"
	case "texcoord1":
		return "TEXCOORD1"
	case "texcoord2":
		return "TEXCOORD2"
	case "normalquat":
		return "NORMALQUAT"
	case "view":
		return "VIEW"
	}
	return ""
}

// ---- declarations -----------------------------------------------------------------------------------------

// write_structs writes the shader's structs, each after the structs it contains.
@(private = "file")
write_structs :: proc(h: ^Hlsl, builder: ^strings.Builder) {
	written := make(map[string]bool)
	for info in h.ir.structs {
		write_struct(h, builder, info, &written)
	}
}

@(private = "file")
write_struct :: proc(h: ^Hlsl, builder: ^strings.Builder, info: IR_Struct, written: ^map[string]bool) {
	if written[info.name] {
		return
	}
	written[info.name] = true

	for field in info.fields {
		inner := field.type
		for inner.kind == .ARRAY {
			inner = inner.elem
		}
		if inner.kind == .STRUCT {
			for other in h.ir.structs {
				if other.name == inner.info.name {
					write_struct(h, builder, other, written)
				}
			}
		}
	}

	// A field of the vertex output with no tag still needs a semantic to travel between the stages: it takes a
	// TEXCOORD number the tagged fields don't use. (The 3DS has no such output; that is MBS-E6.)
	is_varying := h.ir.vertex_main != nil && h.ir.vertex_main.result != nil && h.ir.vertex_main.result.kind == .STRUCT && h.ir.vertex_main.result.info.name == info.name
	taken := make(map[string]bool, context.temp_allocator)
	if is_varying {
		for field in info.fields {
			taken[field.out] = true
		}
	}
	next_texcoord := 3

	fmt.sbprintf(builder, "\nstruct %s {{\n", safe_name(info.name))
	for field in info.fields {
		fmt.sbprintf(builder, "    %s", declarator(h, field.type, safe_name(field.name)))
		tag := semantic(field)
		if tag == "" && is_varying && field.attr == "" && field.out == "" {
			tag = fmt.tprintf("TEXCOORD%d", next_texcoord)
			next_texcoord += 1
		}
		if tag != "" {
			fmt.sbprintf(builder, " : %s", tag)
		}
		fmt.sbprintln(builder, ";")
	}
	fmt.sbprintln(builder, "};")
}

@(private = "file")
write_constant_buffers :: proc(h: ^Hlsl, builder: ^strings.Builder) {
	for uniform in h.ir.uniforms {
		if uniform.kind == .GAME {
			continue
		}
		register := FRAME_REGISTER if uniform.kind == .FRAME else RENDER_REGISTER
		fmt.sbprintf(builder, "\ncbuffer %s_block : register(b%d) {{\n", safe_name(uniform.name), register)
		for field in engine_fields(uniform.kind) {
			fmt.sbprintfln(builder, "    %s %s;", engine_type(field.type), block_field_name(uniform.name, field.name))
		}
		fmt.sbprintln(builder, "};")
	}

	any_game := false
	for uniform in h.ir.uniforms {
		any_game ||= uniform.kind == .GAME
	}
	if any_game == false {
		return
	}
	fmt.sbprintfln(builder, "\n// The game's own uniforms, in the order they are declared.")
	fmt.sbprintfln(builder, "cbuffer mbs_game : register(b%d) {{", GAME_REGISTER)
	for uniform in h.ir.uniforms {
		if uniform.kind != .GAME {
			continue
		}
		if uniform.type.kind == .STRUCT && uniform.type.info.name == "" {
			problem(h, fmt.aprintf("the uniform `%s` is a struct written inline; declare the struct with a name first", uniform.name))
			continue
		}
		fmt.sbprintfln(builder, "    %s;", declarator(h, uniform.type, safe_name(uniform.name)))
	}
	fmt.sbprintln(builder, "};")
}

@(private = "file")
write_textures :: proc(h: ^Hlsl, builder: ^strings.Builder) {
	if len(h.ir.textures) == 0 {
		return
	}
	fmt.sbprintln(builder)
	for texture in h.ir.textures {
		fmt.sbprintfln(builder, "Texture2D %s : register(t%d);", safe_name(texture.name), texture.slot)
	}
	fmt.sbprintfln(builder, "SamplerState %s : register(s%d);", SAMPLER_NAME, SAMPLER_REGISTER)
}

@(private = "file")
problem :: proc(h: ^Hlsl, text: string) {
	append(&h.problems, text)
}

// ---- helpers for building structs -------------------------------------------------------------------------

@(private = "file")
helper_name :: proc(struct_name: string) -> string {
	return fmt.aprintf("mbs_make_%s", struct_name)
}

// Math_Helper is `mod`, `sin_approx` or `cos_approx` for one argument type. HLSL allows several functions with one
// name, so each type gets its own `mbs_mod(float3, float3)` and so on.
@(private = "file")
Math_Helper :: struct {
	name:          string, // "mod", "sin_approx" or "cos_approx"
	type:          string, // the HLSL type of the first argument and the result: float, float2, float3, float4
	scalar_second: bool, // `mod(v, 2.0)`: the second argument is one float for every component
}

// SIN_COEFFICIENTS and COS_COEFFICIENTS are the polynomials of docs/shader_language.md, section 15, highest
// power first. They are the same numbers on every target, so a shader gives the same picture on each.
@(rodata, private = "file")
SIN_COEFFICIENTS := [?]string{"2.1478728533851322e-06", "-0.0001926499619928568", "0.008308984952537351", "-0.16662438501484986", "0.9999793879828708"}

@(rodata, private = "file")
COS_COEFFICIENTS := [?]string{"-2.1978878103077777e-07", "2.4204400324072683e-05", "-0.001385891587244809", "0.041659822182074986", "-0.4999942680922626", "0.9999992215743202"}

@(private = "file")
use_math_helper :: proc(h: ^Hlsl, name: string, first: ^Type, second: ^Type) -> string {
	helper := Math_Helper {
		name          = name,
		type          = base_type(h, first),
		scalar_second = second != nil && first.kind == .VECTOR && second.kind == .F32,
	}
	key := fmt.aprintf("%s|%s|%v", helper.name, helper.type, helper.scalar_second)
	if h.math_seen[key] == false {
		h.math_seen[key] = true
		append(&h.math, helper)
	}
	return fmt.aprintf("mbs_%s", name)
}

@(private = "file")
write_math_helpers :: proc(h: ^Hlsl, builder: ^strings.Builder) {
	for helper in h.math {
		switch helper.name {
		case "mod":
			// Odin's `linalg.mod`: the result has the sign of `b`
			second := "float" if helper.scalar_second else helper.type
			fmt.sbprintfln(builder, "\n%s mbs_mod(%s a, %s b) {{", helper.type, helper.type, second)
			fmt.sbprintln(builder, "    return a - b * floor(a / b);")
			fmt.sbprintln(builder, "}")
		case "sin_approx":
			write_polynomial_helper(builder, helper.type, "sin_approx", SIN_COEFFICIENTS[:], "r * p")
		case "cos_approx":
			write_polynomial_helper(builder, helper.type, "cos_approx", COS_COEFFICIENTS[:], "p")
		case "normal_quaternion":
			write_normal_quaternion_helper(builder)
		}
	}
}

/*
	The rotation taking +Z to n, (vector part, scalar). n straight away from +Z has no axis, so `1 + n.z` is kept at
	least 0.00001 and the result becomes the identity there, as the 3DS's L0 formula does (docs/shader_pica.md)
*/
@(private = "file")
write_normal_quaternion_helper :: proc(builder: ^strings.Builder) {
	fmt.sbprintln(builder, "\nfloat4 mbs_normal_quaternion(float3 n) {")
	fmt.sbprintln(builder, "    return normalize(float4(-n.y, n.x, 0.0, max(1.0 + n.z, 0.00001)));")
	fmt.sbprintln(builder, "}")
}

// write_polynomial_helper writes the argument reduction and the Horner evaluation of section 15.
@(private = "file")
write_polynomial_helper :: proc(builder: ^strings.Builder, type: string, name: string, coefficients: []string, result: string) {
	fmt.sbprintfln(builder, "\n%s mbs_%s(%s x) {{", type, name, type)
	fmt.sbprintfln(builder, "    %s k = floor(x * 0.15915494309189535 + 0.5);", type)
	fmt.sbprintfln(builder, "    %s r = x - 6.283185307179586 * k;", type)
	fmt.sbprintfln(builder, "    %s t = r * r;", type)
	fmt.sbprintfln(builder, "    %s p = %s;", type, coefficients[0])
	for coefficient in coefficients[1:] {
		fmt.sbprintfln(builder, "    p = p * t %s %s;", "-" if coefficient[0] == '-' else "+", coefficient[1:] if coefficient[0] == '-' else coefficient)
	}
	fmt.sbprintfln(builder, "    return %s;", result)
	fmt.sbprintln(builder, "}")
}

// write_light_block declares what the light built-ins read and writes their functions (lighting.odin). The lights
// block is b3, after the game's own at b2, so a shader that doesn't light keeps the registers it had.
@(private = "file")
write_light_block :: proc(h: ^Hlsl, builder: ^strings.Builder) {
	count := get_max_lights(.PC)
	fmt.sbprintln(builder, "\ncbuffer mbs_lights_block : register(b3) {")
	fmt.sbprintfln(builder, "    float4 %s;", LIGHT_UNIFORM_NAMES[0])
	for name in LIGHT_UNIFORM_NAMES[1:] {
		fmt.sbprintfln(builder, "    float4 %s[%d];", name, count)
	}
	// where the loops stop: PC has 64 slots, and a scene rarely fills them (lighting.odin)
	fmt.sbprintln(builder, "    int lights_count;")
	fmt.sbprintln(builder, "};")

	render_block := ""
	for uniform in h.ir.uniforms {
		if uniform.kind == .RENDER {
			render_block = safe_name(uniform.name)
		}
	}
	if render_block == "" {
		// the specular reads the part's material from the render block, which this shader didn't declare
		render_block = "render"
		fmt.sbprintfln(builder, "\ncbuffer render_block : register(b%d) {{", RENDER_REGISTER)
		for field in RENDER_FIELDS {
			fmt.sbprintfln(builder, "    %s %s;", engine_type(field.type), block_field_name(render_block, field.name))
		}
		fmt.sbprintln(builder, "};")
	}
	write_light_functions(builder, render_block, "lights_count")
}

@(private = "file")
write_helpers :: proc(h: ^Hlsl, builder: ^strings.Builder) {
	if h.lights {
		write_light_block(h, builder)
	}
	write_math_helpers(h, builder)
	for struct_name in h.helpers {
		for info in h.ir.structs {
			if info.name != struct_name {
				continue
			}
			fmt.sbprintf(builder, "\n%s %s(", safe_name(info.name), helper_name(info.name))
			for field, index in info.fields {
				if index > 0 {
					fmt.sbprint(builder, ", ")
				}
				fmt.sbprint(builder, declarator(h, field.type, safe_name(field.name)))
			}
			fmt.sbprintfln(builder, ") {{")
			fmt.sbprintfln(builder, "    %s result;", safe_name(info.name))
			for field in info.fields {
				fmt.sbprintfln(builder, "    result.%s = %s;", safe_name(field.name), safe_name(field.name))
			}
			fmt.sbprintln(builder, "    return result;")
			fmt.sbprintln(builder, "}")
		}
	}
}

// ---- procedures and statements ----------------------------------------------------------------------------

@(private = "file")
write_proc :: proc(h: ^Hlsl, builder: ^strings.Builder, info: ^IR_Proc) {
	clear(&h.names)
	taken := make(map[string]bool)

	if info.result.kind == .ARRAY {
		problem(h, fmt.aprintf("`%s` returns an array, which HLSL can't do", info.name))
		return
	}

	result := "void" if info.result.kind == .VOID else base_type(h, info.result)
	fmt.sbprintf(builder, "\n%s %s(", result, safe_name(info.name))
	for param, index in info.params {
		if index > 0 {
			fmt.sbprint(builder, ", ")
		}
		fmt.sbprint(builder, declarator(h, param.type, local_name(h, &taken, param)))
	}
	fmt.sbprint(builder, ")")
	if info.stage == .FRAGMENT {
		fmt.sbprint(builder, " : SV_TARGET")
	}
	fmt.sbprintln(builder, " {")
	write_statements(h, builder, &taken, info.body, 1)
	fmt.sbprintln(builder, "}")
}

@(private = "file")
write_statements :: proc(h: ^Hlsl, builder: ^strings.Builder, taken: ^map[string]bool, statements: []^IR_Stmt, depth: int) {
	for statement in statements {
		write_statement(h, builder, taken, statement, depth)
	}
}

@(private = "file")
indent :: proc(builder: ^strings.Builder, depth: int) {
	for _ in 0 ..< depth {
		fmt.sbprint(builder, "    ")
	}
}

@(private = "file")
write_statement :: proc(h: ^Hlsl, builder: ^strings.Builder, taken: ^map[string]bool, statement: ^IR_Stmt, depth: int) {
	indent(builder, depth)
	switch node in statement.variant {
	case IR_Declare:
		write_declaration(h, builder, taken, node)
	case IR_Assign:
		fmt.sbprintfln(builder, "%s = %s;", expr(h, node.target), bare(h, node.value))
	case IR_If:
		fmt.sbprintfln(builder, "if (%s) {{", bare(h, node.condition))
		write_statements(h, builder, taken, node.then, depth + 1)
		if len(node.otherwise) > 0 {
			indent(builder, depth)
			fmt.sbprintln(builder, "} else {")
			write_statements(h, builder, taken, node.otherwise, depth + 1)
		}
		indent(builder, depth)
		fmt.sbprintln(builder, "}")
	case IR_For:
		counter := local_name(h, taken, node.var)
		compare := "<=" if node.inclusive else "<"
		fmt.sbprintfln(builder, "for (int %s = %s; %s %s %s; %s++) {{", counter, bare(h, node.from), counter, compare, bare(h, node.to), counter)
		write_statements(h, builder, taken, node.body, depth + 1)
		indent(builder, depth)
		fmt.sbprintln(builder, "}")
	case IR_Return:
		if node.value != nil {
			fmt.sbprintfln(builder, "return %s;", bare(h, node.value))
		} else {
			fmt.sbprintln(builder, "return;")
		}
	case IR_Eval:
		fmt.sbprintfln(builder, "%s;", bare(h, node.call))
	case IR_Block:
		fmt.sbprintln(builder, "{")
		write_statements(h, builder, taken, node.body, depth + 1)
		indent(builder, depth)
		fmt.sbprintln(builder, "}")
	}
}

@(private = "file")
write_declaration :: proc(h: ^Hlsl, builder: ^strings.Builder, taken: ^map[string]bool, node: IR_Declare) {
	// the value is written before the name is chosen: it can't mention the variable it initialises
	value: string
	if node.init == nil {
		value = zero_value(h, node.var.type)
	} else if literal, is_literal := node.init.variant.(IR_Construct); is_literal && node.init.type.kind == .ARRAY {
		value = array_initializer(h, literal)
	} else {
		value = bare(h, node.init)
	}
	name := local_name(h, taken, node.var)
	qualifier := "" if node.var.mutable else "const "
	fmt.sbprintfln(builder, "%s%s = %s;", qualifier, declarator(h, node.var.type, name), value)
}

// array_initializer is `{ a, b, c }`, which HLSL allows only where a variable is declared.
@(private = "file")
array_initializer :: proc(h: ^Hlsl, construct: IR_Construct) -> string {
	return fmt.aprintf("{{ %s }}", list(h, construct.args))
}

@(private = "file")
zero_value :: proc(h: ^Hlsl, type: ^Type) -> string {
	if type.kind == .ARRAY {
		return fmt.aprintf("(%s%s)0", base_type(h, type), array_suffix(type))
	}
	return fmt.aprintf("(%s)0", base_type(h, type))
}

// ---- expressions ------------------------------------------------------------------------------------------

// bare is an expression for a place that already has its own delimiters or ends at a `;`, so the parentheses that
// wrap the whole of it can go: `(a + b)` becomes `a + b`, and `(a) * (b)` stays as it is.
@(private = "file")
bare :: proc(h: ^Hlsl, e: ^IR_Expr) -> string {
	text := expr(h, e)
	if len(text) < 2 || text[0] != '(' || text[len(text) - 1] != ')' {
		return text
	}
	depth := 0
	for character, index in transmute([]u8)text {
		if character == '(' {
			depth += 1
		} else if character == ')' {
			depth -= 1
			if depth == 0 && index != len(text) - 1 {
				return text
			}
		}
	}
	return text[1:len(text) - 1]
}

@(private = "file")
list :: proc(h: ^Hlsl, items: []^IR_Expr) -> string {
	parts := make([]string, len(items))
	for item, index in items {
		parts[index] = expr(h, item)
	}
	return strings.join(parts, ", ")
}

@(private = "file")
expr :: proc(h: ^Hlsl, e: ^IR_Expr) -> string {
	switch node in e.variant {
	case IR_Float:
		return float_literal(node.value)
	case IR_Int:
		return fmt.aprintf("%d", node.value) if e.type.kind == .I32 else fmt.aprintf("%du", node.value)
	case IR_Bool:
		return "true" if node.value else "false"
	case IR_Zero:
		return zero_value(h, e.type)
	case IR_Var_Ref:
		if name, found := h.names[node.var]; found {
			return name
		}
		return safe_name(node.var.name)
	case IR_Uniform_Ref:
		// a whole engine block can't be named in HLSL; only its fields can (see IR_Field below)
		return safe_name(node.name)
	case IR_Texture_Ref:
		return safe_name(node.name)
	case IR_Unary:
		symbol := "-" if node.op == .NEGATE else "!"
		return fmt.aprintf("(%s%s)", symbol, expr(h, node.operand))
	case IR_Binary:
		return binary(h, node)
	case IR_Swizzle:
		components := "xyzw"
		letters: [4]u8
		for index in 0 ..< node.count {
			letters[index] = components[node.indices[index]]
		}
		return fmt.aprintf("%s.%s", expr(h, node.base), string(letters[:node.count]))
	case IR_Field:
		if uniform, is_uniform := node.base.variant.(IR_Uniform_Ref); is_uniform && uniform.kind != .GAME {
			return block_field_name(uniform.name, node.name)
		}
		return fmt.aprintf("%s.%s", expr(h, node.base), safe_name(node.name))
	case IR_Index:
		return fmt.aprintf("%s[%s]", expr(h, node.base), expr(h, node.index))
	case IR_Convert:
		return fmt.aprintf("((%s)(%s))", base_type(h, e.type), expr(h, node.operand))
	case IR_Construct:
		return construct(h, e, node)
	case IR_Builtin_Call:
		return builtin_call(h, e, node)
	case IR_Proc_Call:
		calls := h.calls[h.current]
		append(&calls, node.callee.name)
		h.calls[h.current] = calls
		return fmt.aprintf("%s(%s)", safe_name(node.callee.name), list(h, node.args))
	}
	return "?"
}

@(private = "file")
binary :: proc(h: ^Hlsl, node: IR_Binary) -> string {
	left, right := expr(h, node.left), expr(h, node.right)
	// `*` between matrices, or a vector and a matrix, is a matrix product; HLSL's own `*` works per element
	if node.op == .MUL {
		left_matrix, right_matrix := node.left.type.kind == .MATRIX, node.right.type.kind == .MATRIX
		is_scale := node.left.type.kind == .F32 || node.right.type.kind == .F32
		if (left_matrix || right_matrix) && is_scale == false {
			return fmt.aprintf("mul(%s, %s)", left, right)
		}
	}
	symbol: string
	switch node.op {
	case .ADD:
		symbol = "+"
	case .SUB:
		symbol = "-"
	case .MUL:
		symbol = "*"
	case .DIV:
		symbol = "/"
	case .LESS:
		symbol = "<"
	case .GREATER:
		symbol = ">"
	case .LESS_EQUAL:
		symbol = "<="
	case .GREATER_EQUAL:
		symbol = ">="
	case .EQUAL:
		symbol = "=="
	case .NOT_EQUAL:
		symbol = "!="
	case .AND:
		symbol = "&&"
	case .OR:
		symbol = "||"
	}
	return fmt.aprintf("(%s %s %s)", left, symbol, right)
}

@(private = "file")
construct :: proc(h: ^Hlsl, e: ^IR_Expr, node: IR_Construct) -> string {
	#partial switch e.type.kind {
	case .VECTOR, .MATRIX:
		return fmt.aprintf("%s(%s)", base_type(h, e.type), list(h, node.args))
	case .STRUCT:
		name := e.type.info.name
		if h.helper_seen[name] == false {
			h.helper_seen[name] = true
			append(&h.helpers, name)
		}
		return fmt.aprintf("%s(%s)", helper_name(name), list(h, node.args))
	}
	problem(h, "an array written as a value can only start a variable (`a := [2]f32{...}`), not be passed or returned")
	return "?"
}

@(private = "file")
float_literal :: proc(value: f32) -> string {
	buffer: [32]u8
	text := strconv.write_float(buffer[:], f64(value), 'g', -1, 32, {})
	for character in transmute([]u8)text {
		if character == '.' || character == 'e' || character == 'E' {
			return strings.clone(text)
		}
	}
	return fmt.aprintf("%s.0", text)
}

// ---- built-in functions -----------------------------------------------------------------------------------

// Built-ins that HLSL has under another name.
@(rodata, private = "file")
RENAMED := [?][2]string{{"inverse_sqrt", "rsqrt"}, {"ln", "log"}, {"fract", "frac"}, {"to_radians", "radians"}, {"to_degrees", "degrees"}, {"is_nan", "isnan"}, {"is_inf", "isinf"}}

// Built-ins that HLSL has under the same name and with the same meaning.
@(rodata, private = "file")
SAME_NAME := [?]string {
	"abs", "floor", "ceil", "trunc", "round", "saturate", "min", "max", "clamp", "fmod", "step", "lerp", "smoothstep", "sqrt",
	"exp", "exp2", "log2", "log10", "pow", "sin", "cos", "tan", "asin", "acos", "atan", "atan2", "sinh", "cosh", "tanh",
	"ldexp", "dot", "length", "distance", "normalize", "cross", "reflect", "refract", "transpose", "determinant",
	"ddx", "ddy", "fwidth",
}

@(private = "file")
builtin_call :: proc(h: ^Hlsl, e: ^IR_Expr, node: IR_Builtin_Call) -> string {
	switch node.name {
	case "sample":
		h.samples[h.current] = true
		return fmt.aprintf("%s.%s(%s, %s%s)", expr(h, node.args[0]), SAMPLE_METHOD, SAMPLER_NAME, expr(h, node.args[1]), SAMPLE_LEVEL)
	case "sample_lod":
		return fmt.aprintf("%s.SampleLevel(%s, %s, %s)", expr(h, node.args[0]), SAMPLER_NAME, expr(h, node.args[1]), expr(h, node.args[2]))
	case "sample_bias":
		return fmt.aprintf("%s.SampleBias(%s, %s, %s)", expr(h, node.args[0]), SAMPLER_NAME, expr(h, node.args[1]), expr(h, node.args[2]))
	case "sample_grad":
		return fmt.aprintf("%s.SampleGrad(%s, %s, %s, %s)", expr(h, node.args[0]), SAMPLER_NAME, expr(h, node.args[1]), expr(h, node.args[2]), expr(h, node.args[3]))
	case "discard":
		return "discard"
	case "mod":
		return fmt.aprintf("%s(%s)", use_math_helper(h, "mod", node.args[0].type, node.args[1].type), list(h, node.args))
	case "light_diffuse", "light_specular":
		h.lights = true
		return fmt.aprintf("mbs_%s(%s)", node.name, list(h, node.args))
	case "sin_approx", "cos_approx", "normal_quaternion":
		return fmt.aprintf("%s(%s)", use_math_helper(h, node.name, node.args[0].type, nil), list(h, node.args))
	case "dot3_signed":
		// `4 * dot(a.rgb - 0.5, b.rgb - 0.5)`; a fourth component, if there is one, is left out
		suffix := ".xyz" if node.args[0].type.count == 4 else ""
		return fmt.aprintf("(4.0 * dot(%s%s - 0.5, %s%s - 0.5))", expr(h, node.args[0]), suffix, expr(h, node.args[1]), suffix)
	case "sign":
		// HLSL's `sign` gives an int; the language's gives the same type as its argument
		return fmt.aprintf("((%s)sign(%s))", base_type(h, e.type), list(h, node.args))
	}
	for pair in RENAMED {
		if pair[0] == node.name {
			return fmt.aprintf("%s(%s)", pair[1], list(h, node.args))
		}
	}
	for name in SAME_NAME {
		if name == node.name {
			return fmt.aprintf("%s(%s)", name, list(h, node.args))
		}
	}
	problem(h, fmt.aprintf("`%s` isn't written for HLSL yet", node.name))
	return "?"
}
